---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostGrid from '@/components/PostGrid.astro';
import { categories, themeConfig } from '@/config';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((post) => post.data.category === category.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${category.name} · 分类 · ${themeConfig.site.title}`}>
  <header class="page-hero">
    <h1 class={`cat-${category.id}`}>
      <span class="cat">{category.name}</span>
    </h1>
    <p class="lead">{category.description}</p>
    <p class="page-meta">
      <span>{posts.length} 篇</span>
      <a href="/categories/">全部分类 →</a>
    </p>
  </header>

  <PostGrid posts={posts} />
</BaseLayout>

<style>
  /* 大标题里直接放分类色，比再写一遍「分类：」轻；标题已经够大，不再加点 */
  .page-hero h1 .cat {
    font-size: inherit;
    font-weight: 600;
    letter-spacing: inherit;
  }
  .page-hero h1 .cat::before {
    display: none;
  }
  .page-meta a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .page-meta a:hover {
    color: var(--accent);
  }
</style>
