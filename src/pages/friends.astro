---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { themeConfig } from '@/config';

const { self, links } = themeConfig.friends;
const title = `友链 · ${themeConfig.site.title}`;

// 展示/复制给别人用的必须是完整地址，而 avatar 写的是 public 下的相对路径
const selfAvatar = new URL(self.avatar!, themeConfig.site.website).href;

// 无头像时用名字首字做占位（emoji 和汉字都按「一个字符」处理）
const initial = (name: string) => [...name.trim()][0] ?? '?';
---

<BaseLayout title={title}>
  <header class="page-hero">
    <h1>友链</h1>
    <p class="lead">一些常读的站点。想交换友链，去留言板留个地址就行。</p>
  </header>

  <section aria-labelledby="self-title">
    <h2 class="section-title" id="self-title">本站</h2>
    <div class="self-card">
      <div class="profile">
        <img class="avatar" src={self.avatar} alt="" width="64" height="64" loading="lazy" />
        <div class="profile-text">
          <p class="name">{self.name}</p>
          <p class="desc">{self.description}</p>
          <p class="url">{self.url}</p>
          <button id="copy-info" class="copy" type="button">复制信息</button>
        </div>
      </div>
      <dl class="info">
        <dt>名称</dt><dd>{self.name}</dd>
        <dt>地址</dt><dd>{self.url}</dd>
        <dt>头像</dt><dd>{selfAvatar}</dd>
        <dt>描述</dt><dd>{self.description}</dd>
      </dl>
    </div>
  </section>

  <section aria-labelledby="friends-title">
    <h2 class="section-title" id="friends-title">朋友们</h2>
    {
      links.length ? (
        <ul class="friend-grid">
          {links.map((friend) => (
            <li>
              <a class="friend-card" href={friend.url} target="_blank" rel="noopener noreferrer">
                {/* 首字始终垫在底层，外链头像加载失败就移除自己，露出首字 */}
                <span class="avatar-slot">
                  <span class="placeholder" aria-hidden="true">{initial(friend.name)}</span>
                  {friend.avatar && (
                    <img
                      class="avatar-img"
                      src={friend.avatar}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      onerror="this.remove()"
                    />
                  )}
                </span>
                <span class="meta">
                  <span class="name">{friend.name}</span>
                  {friend.description && <span class="desc">{friend.description}</span>}
                </span>
                <span class="go" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">暂时还没有友链。</p>
      )
    }
  </section>

  <section class="comments" aria-label="友链评论">
    <h2 class="section-title">留言交流</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo="dongyue12/giscus"
      data-repo-id="R_kgDOSakHjA"
      data-category="Announcements"
      data-category-id="DIC_kwDOSakHjM4C8zJM"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-loading="lazy"
      data-lang={themeConfig.site.language}
      crossorigin="anonymous"
      async
      is:inline></script>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var btn = document.getElementById('copy-info');
    if (!btn || !navigator.clipboard) return;
    // 从服务端渲染好的 dd 里取原文，避免把信息在模板和脚本里各写一份
    var v = document.querySelectorAll('.info dd');
    var text =
      'name: "' + v[0].textContent + '"\nurl: "' + v[1].textContent +
      '"\nimg: "' + v[2].textContent + '"\ndesc: "' + v[3].textContent + '"';
    var original = btn.textContent;

    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(text).then(
        function () {
          btn.textContent = '已复制';
          setTimeout(function () {
            btn.textContent = original;
          }, 1500);
        },
        function () {
          btn.textContent = '复制失败';
          setTimeout(function () {
            btn.textContent = original;
          }, 1500);
        },
      );
    });
  })();
</script>

<style>
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  section + section {
    margin-top: 3.5rem;
  }

  .comments {
    margin-bottom: 2rem;
  }

  /* 本站信息：左边名片，右边一份可复制的完整字段 */
  .self-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 2rem;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  .profile {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .profile-text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .profile-text p {
    margin: 0;
  }
  .profile-text .name {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .profile-text .desc {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .profile-text .url {
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }

  .avatar {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--paper-2);
    box-shadow: 0 0 0 1px var(--line);
  }

  .copy {
    margin-top: 0.9rem;
    font: inherit;
    font-size: var(--text-s);
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .copy:hover {
    border-color: var(--accent-line);
  }

  .info {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-content: start;
    gap: 0.5rem 1rem;
    margin: 0;
    padding-left: 2rem;
    border-left: 1px solid var(--line);
    font-size: var(--text-s);
    line-height: 1.6;
  }

  .info dt {
    color: var(--ink-3);
  }

  .info dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }

  /* 友链卡片：三列，悬停整块上浮 */
  .friend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .friend-card:hover {
    border-color: var(--accent-line);
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  .go {
    margin-left: auto;
    flex: none;
    font-size: 0.8125rem;
    color: var(--ink-3);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .friend-card:hover .go {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* 头像槽：首字占位在底层，外链图覆盖在上层，加载失败时自然露出首字 */
  .avatar-slot {
    position: relative;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--paper-2);
    box-shadow: 0 0 0 1px var(--line);
  }

  .avatar-slot .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    font-size: var(--text-s);
    user-select: none;
  }

  .avatar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.45;
  }

  .name,
  .desc {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .name {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .desc {
    color: var(--ink-2);
    font-size: var(--text-s);
  }

  .empty {
    color: var(--ink-2);
    margin: 0;
  }

  @media (max-width: 1000px) {
    .friend-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .self-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .info {
      padding-left: 0;
      border-left: 0;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
      grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .friend-grid {
      grid-template-columns: 1fr;
    }
    .info {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
  }
</style>
