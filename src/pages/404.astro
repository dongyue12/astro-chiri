---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { themeConfig } from '@/config';
---

<BaseLayout title={`页面不存在 · ${themeConfig.site.title}`} description="这个地址没有对应的页面。">
  <div class="not-found">
    <h1>页面不存在</h1>
    <p class="hint">链接可能已经失效，或者地址输错了。</p>
    <div class="actions">
      <a class="back" href="/">返回文章列表 <span aria-hidden="true">→</span></a>
      <a class="ghost" href="/tags/">按标签浏览</a>
    </div>
    <span class="num" aria-hidden="true">404</span>
  </div>
</BaseLayout>

<style>
  /* 巨大的 404 只当背景水印，放在标题之后，不抢第一眼 */
  .not-found {
    position: relative;
    max-width: 44rem;
    margin: 4rem auto 6rem;
    padding: 3rem 0;
    isolation: isolate;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .hint {
    margin: 0 0 2.25rem;
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.15rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--paper);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: opacity var(--dur) var(--ease);
  }

  .back:hover {
    opacity: 0.88;
  }

  .ghost {
    color: var(--ink-2);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .ghost:hover {
    color: var(--accent);
  }

  .num {
    position: absolute;
    right: -2rem;
    top: -4rem;
    z-index: -1;
    font-family: var(--mono);
    font-size: clamp(9rem, 24vw, 16rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--line);
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .num {
      right: -1rem;
      top: -2.5rem;
      font-size: 8rem;
    }
  }
</style>
