---
import "@/styles/pages/rank-standalone.css";
import "@/styles/pages/image-tool.css";

const title = "图片处理";
const description =
	"在线做图片格式转换、缩放、裁剪、圆角、旋转翻转与亮度调整，逐张编辑、批量导出。全部在浏览器本地完成，图片不会上传。";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title} · 工具箱</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline>
      // 首屏渲染前定好主题：用户选过就沿用，否则跟随系统
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("tool-theme");
        } catch (e) {}
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        } else {
          document.documentElement.dataset.theme = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches
            ? "dark"
            : "light";
        }
      })();
    </script>
  </head>
  <body>
    <header class="tool-topbar">
      <a class="tool-back" href="/tools/">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8h5Z"></path>
        </svg>
        工具箱
      </a>
      <h1 class="tool-title">{title}</h1>
      <span class="tool-chip">图片不上传</span>
      <button
        class="tool-theme-btn"
        type="button"
        id="tool-theme"
        title="切换深色 / 浅色"
        aria-label="切换深浅色主题"
      >
        <span class="tool-theme-icon" aria-hidden="true"></span>
      </button>
    </header>

    <main class="tool-main">
      <div class="img-app">
        <!-- 左：预览 + 缩略图 -->
        <section class="img-main">
          <div class="img-drop" id="img-drop" role="button" tabindex="0">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M19 13v6H5v-6H3v6q0 .825.588 1.413Q4.175 21 5 21h14q.825 0 1.413-.587Q21 19.825 21 19v-6h-2ZM12 3 7 8l1.4 1.45 2.6-2.6V16h2V6.85l2.6 2.6L17 8l-5-5Z"
              ></path>
            </svg>
            <strong>点击选择图片，或直接拖进来</strong>
            <span>支持 PNG / JPEG / WebP / GIF / AVIF，可一次多选</span>
            <small>所有处理都在你的浏览器里完成，不会上传到服务器</small>
          </div>
          <input id="img-input" type="file" accept="image/*" multiple hidden />

          <!-- 主预览：当前正在编辑的那张 -->
          <div class="img-stage" id="img-stage" hidden>
            <div class="img-stage-bar">
              <span class="stage-name" id="stage-name"></span>
              <span class="stage-meta" id="stage-meta"></span>
              <button class="stage-btn" type="button" id="btn-draw-one">绘制</button>
              <button class="stage-btn" type="button" id="btn-crop-one">裁剪</button>
              <button class="stage-btn" type="button" id="btn-save-one">
                下载这张
              </button>
              <span class="stage-ops" id="stage-draw-ops" hidden>
                <button class="stage-btn" type="button" data-draw-act="undo" disabled>
                  撤销
                </button>
                <button class="stage-btn" type="button" data-draw-act="redo" disabled>
                  重做
                </button>
                <button class="stage-btn" type="button" data-draw-act="reset">
                  还原
                </button>
                <button class="stage-btn" type="button" data-draw-act="cancel">
                  取消
                </button>
                <button class="stage-btn stage-btn-primary" type="button" data-draw-act="apply">
                  应用
                </button>
              </span>
            </div>
            <canvas class="img-preview" id="img-preview"></canvas>
            <div class="draw-holder" id="draw-holder" hidden>
              <div class="draw-inner" id="draw-inner">
                <canvas class="draw-base" id="draw-base"></canvas>
                <canvas id="img-draw"></canvas>
              </div>
            </div>
            <span class="draw-hint" id="draw-hint" hidden></span>
          </div>

          <!-- 缩略图条：其余图片都在这里 -->
          <div class="img-strip" id="img-strip" hidden></div>
        </section>

        <!-- 右：设置面板（作用于当前这张）-->
        <aside class="img-panel" id="img-panel" data-empty="1">
          <div class="panel-tabs" role="tablist" aria-label="编辑分类">
            <button
              class="panel-tab"
              type="button"
              role="tab"
              data-tab="size"
              aria-selected="true"
            >
              尺寸
            </button>
            <button
              class="panel-tab"
              type="button"
              role="tab"
              data-tab="color"
              aria-selected="false"
            >
              调色
            </button>
            <button
              class="panel-tab"
              type="button"
              role="tab"
              data-tab="draw"
              aria-selected="false"
            >
              绘制
            </button>
            <button
              class="panel-tab"
              type="button"
              role="tab"
              data-tab="out"
              aria-selected="false"
            >
              输出
            </button>
          </div>

          <div class="panel-scroll">
            <!-- 尺寸 -->
            <div class="panel-page" data-page="size">
              <div class="panel-section">
                <div class="panel-title">
                  <span>输出宽度</span>
                  <span class="panel-val" id="val-width">原始</span>
                </div>
                <div class="num-row">
                  <input
                    type="number"
                    id="in-width"
                    min="1"
                    step="1"
                    placeholder="留空 = 原始宽度"
                  />
                  <span class="num-suffix">px</span>
                </div>
                <div class="panel-note">高度按原比例自动计算</div>
              </div>

              <div class="panel-section">
                <div class="panel-title">
                  <span>裁剪比例</span>
                  <span class="panel-val" id="val-crop">原比例</span>
                </div>
                <div class="seg seg-wrap" id="seg-crop">
                  <button type="button" data-ratio="original" aria-pressed="true">原比例</button>
                  <button type="button" data-ratio="1:1" aria-pressed="false">1:1</button>
                  <button type="button" data-ratio="4:3" aria-pressed="false">4:3</button>
                  <button type="button" data-ratio="3:4" aria-pressed="false">3:4</button>
                  <button type="button" data-ratio="16:9" aria-pressed="false">16:9</button>
                  <button type="button" data-ratio="9:16" aria-pressed="false">9:16</button>
                </div>
                <div class="panel-note">按比例居中裁切；要自由框选就用大图上的「裁剪」</div>
              </div>

              <div class="panel-section">
                <div class="panel-title"><span>旋转与翻转</span></div>
                <div class="btn-group">
                  <button class="icon-btn" type="button" id="btn-rot-l">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M7.1 16.9q-2-2-2-4.9t2-4.9Q9.1 5 12 5h.2L9.6 2.4 11 1l4.9 5L11 11l-1.4-1.4L12.2 7H12q-2 0-3.5 1.5T7 12q0 2 1.5 3.5T12 17v2q-2.9 0-4.9-2.1Z"></path>
                    </svg>
                    左转
                  </button>
                  <button class="icon-btn" type="button" id="btn-rot-r">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M16.9 16.9q2-2 2-4.9t-2-4.9Q14.9 5 12 5h-.2l2.6-2.6L13 1 8.1 6l4.9 5 1.4-1.4L11.8 7h.2q2 0 3.5 1.5T17 12q0 2-1.5 3.5T12 17v2q2.9 0 4.9-2.1Z"></path>
                    </svg>
                    右转
                  </button>
                </div>
                <div class="btn-group">
                  <button class="icon-btn" type="button" id="btn-flip-h" aria-pressed="false">
                    水平翻转
                  </button>
                  <button class="icon-btn" type="button" id="btn-flip-v" aria-pressed="false">
                    垂直翻转
                  </button>
                </div>
              </div>

              <div class="panel-section">
                <div class="panel-title">
                  <span>圆角</span>
                  <span class="panel-val" id="val-radius">0%</span>
                </div>
                <div class="slider-row">
                  <input type="range" id="in-radius" min="0" max="50" value="0" aria-label="圆角半径" />
                </div>
                <div class="panel-note">按短边百分比算，50% 为完全圆角</div>
              </div>
            </div>

            <!-- 调色 -->
            <div class="panel-page" data-page="color" hidden>
              <div class="panel-section">
                <div class="panel-title">
                  <span>亮度</span>
                  <span class="panel-val" id="val-bright">100%</span>
                </div>
                <div class="slider-row">
                  <input type="range" id="in-bright" min="20" max="200" value="100" aria-label="亮度" />
                </div>
              </div>

              <div class="panel-section">
                <div class="panel-title">
                  <span>对比度</span>
                  <span class="panel-val" id="val-contrast">100%</span>
                </div>
                <div class="slider-row">
                  <input type="range" id="in-contrast" min="20" max="200" value="100" aria-label="对比度" />
                </div>
              </div>

              <div class="panel-section">
                <div class="panel-title">
                  <span>饱和度</span>
                  <span class="panel-val" id="val-saturate">100%</span>
                </div>
                <div class="slider-row">
                  <input type="range" id="in-saturate" min="0" max="200" value="100" aria-label="饱和度" />
                </div>
                <div class="panel-note">三项都只影响画面，不改原文件</div>
              </div>
            </div>

            <!-- 绘制 -->
            <div class="panel-page" data-page="draw" hidden>
              <div class="panel-section">
                <div class="panel-title"><span>工具</span></div>
                <div class="draw-tools" data-role="tools">
                  <button class="draw-tool" type="button" data-tool="select" aria-pressed="true">
                    选择
                  </button>
                  <button class="draw-tool" type="button" data-tool="text" aria-pressed="false">
                    文字
                  </button>
                  <button class="draw-tool" type="button" data-tool="shape" aria-pressed="false">
                    形状
                  </button>
                  <button class="draw-tool" type="button" data-tool="pen" aria-pressed="false">
                    画笔
                  </button>
                  <button class="draw-tool" type="button" data-tool="bucket" aria-pressed="false">
                    填色
                  </button>
                </div>
              </div>

              <div class="panel-section" data-show="text" hidden>
                <div class="panel-title">
                  <span>文字</span>
                  <span class="panel-val" data-val="size"></span>
                </div>
                <div class="draw-field">
                  <input
                    class="draw-text-input"
                    id="draw-text"
                    type="text"
                    maxlength="80"
                    placeholder="输入文字，再点画布"
                    aria-label="文字内容"
                  />
                </div>
                <div class="draw-field">
                  <input
                    class="draw-slider"
                    type="range"
                    min="2"
                    max="30"
                    step="1"
                    value="8"
                    data-role="size"
                    aria-label="字号"
                  />
                </div>
                <div class="btn-group">
                  <button class="icon-btn" type="button" data-draw-act="bold" aria-pressed="true">
                    加粗
                  </button>
                  <button class="icon-btn" type="button" data-draw-act="italic" aria-pressed="false">
                    斜体
                  </button>
                </div>
                <div class="panel-note">
                  点画布放文字，选中后在这里改内容、字号、颜色
                </div>
              </div>

              <div class="panel-section" data-show="shape" hidden>
                <div class="panel-title"><span>形状</span></div>
                <div class="draw-chips" data-role="shapes">
                  <button class="draw-chip" type="button" data-shape="rect" aria-pressed="true">
                    矩形
                  </button>
                  <button class="draw-chip" type="button" data-shape="circle" aria-pressed="false">
                    圆形
                  </button>
                  <button class="draw-chip" type="button" data-shape="triangle" aria-pressed="false">
                    三角形
                  </button>
                  <button class="draw-chip" type="button" data-shape="diamond" aria-pressed="false">
                    菱形
                  </button>
                  <button class="draw-chip" type="button" data-shape="star" aria-pressed="false">
                    五角星
                  </button>
                  <button class="draw-chip" type="button" data-shape="arrow" aria-pressed="false">
                    箭头
                  </button>
                  <button class="draw-chip" type="button" data-shape="line" aria-pressed="false">
                    直线
                  </button>
                </div>
                <div class="panel-note">点画布放一个默认大小的形状，再拖四角缩放</div>
              </div>

              <div class="panel-section" data-show="pen" hidden>
                <div class="panel-title">
                  <span>画笔粗细</span>
                  <span class="panel-val" data-val="brush"></span>
                </div>
                <div class="draw-field">
                  <input
                    class="draw-slider"
                    type="range"
                    min="1"
                    max="42"
                    step="1"
                    value="8"
                    data-role="brush"
                    aria-label="画笔粗细"
                  />
                </div>
                <div class="panel-note">按住直接画，松手后整笔可以拖动</div>
              </div>

              <div class="panel-section" data-show="bucket" hidden>
                <div class="panel-title"><span>填色</span></div>
                <div class="panel-note">
                  点图片上连成一片的颜色区域，填成「颜色 1」。只填底图，文字和形状不受影响
                </div>
              </div>

              <div class="panel-section" data-role="sel-box" hidden>
                <div class="panel-title">
                  <span>选中</span>
                  <span class="panel-val" data-val="sel"></span>
                </div>
                <div class="btn-group">
                  <button class="icon-btn" type="button" data-draw-act="front" title="上移一层">
                    上移
                  </button>
                  <button class="icon-btn" type="button" data-draw-act="back" title="下移一层">
                    下移
                  </button>
                  <button class="icon-btn" type="button" data-draw-act="dup" title="复制一个">复制</button>
                  <button class="icon-btn" type="button" data-draw-act="delete" title="删除">删除</button>
                </div>
              </div>

              <div class="panel-section">
                <div class="panel-title"><span>颜色</span></div>
                <div class="draw-tools" data-role="modes">
                  <button class="draw-tool" type="button" data-mode="solid" aria-pressed="true">
                    纯色
                  </button>
                  <button class="draw-tool" type="button" data-mode="gradient" aria-pressed="false">
                    渐变
                  </button>
                </div>
                <div class="draw-field">
                  <input class="color-input" type="color" data-color="c1" value="#ff4d4f" aria-label="颜色 1" />
                  <input class="color-input" type="color" data-color="c2" value="#ffd60a" aria-label="颜色 2" />
                  <span class="draw-note">颜色 1 / 颜色 2</span>
                </div>
                <div class="swatches" data-role="swatches"></div>
                <div class="swatches" data-when="gradient" hidden></div>
                <div class="draw-field" data-when="gradient" hidden>
                  <input
                    class="draw-slider"
                    type="range"
                    min="0"
                    max="360"
                    step="1"
                    value="45"
                    data-role="angle"
                    aria-label="渐变角度"
                  />
                  <span class="draw-val" data-val="angle">45°</span>
                </div>
                <div class="draw-field" data-when="gradient" hidden>
                  <button class="draw-chip" type="button" data-gtype="linear" aria-pressed="true">
                    线性
                  </button>
                  <button class="draw-chip" type="button" data-gtype="radial" aria-pressed="false">
                    径向
                  </button>
                </div>
              </div>
            </div>

            <!-- 输出 -->
            <div class="panel-page" data-page="out" hidden>
              <div class="panel-section">
                <div class="panel-title">
                  <span>输出格式</span>
                  <span class="panel-val" id="val-format">原格式</span>
                </div>
                <div class="seg" id="seg-format">
                  <button type="button" data-format="original" aria-pressed="true">原格式</button>
                  <button type="button" data-format="webp" aria-pressed="false">WebP</button>
                  <button type="button" data-format="jpeg" aria-pressed="false">JPEG</button>
                  <button type="button" data-format="png" aria-pressed="false">PNG</button>
                </div>
              </div>

              <div class="panel-section" id="quality-section">
                <div class="panel-title">
                  <span>质量</span>
                  <span class="panel-val" id="val-quality">85%</span>
                </div>
                <div class="slider-row">
                  <input
                    type="range"
                    id="in-quality"
                    min="10"
                    max="100"
                    step="1"
                    value="85"
                    aria-label="输出质量"
                  />
                </div>
                <div class="panel-note" id="quality-note">数值越低体积越小，PNG 为无损</div>
              </div>
            </div>
          </div>

          <div class="panel-actions">
            <button class="act-btn act-btn-primary" type="button" id="btn-export-edited" disabled>
              下载修改的
            </button>
            <div class="act-row">
              <button class="act-btn act-btn-ghost" type="button" id="btn-export-all" disabled>
                全部下载
              </button>
              <button class="act-btn act-btn-ghost" type="button" id="btn-reset">
                重置这张
              </button>
            </div>
            <button class="act-btn act-btn-ghost" type="button" id="btn-apply-all">
              把当前设置应用到全部
            </button>
            <div class="panel-status" id="status">还没有添加图片</div>
          </div>
        </aside>
      </div>
    </main>

    <script>
      import {
        Canvas,
        Rect,
        Circle,
        Triangle,
        Polygon,
        Line,
        IText,
        Point,
        Gradient,
        PencilBrush,
      } from "fabric";

      const ICON_X = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.4 19 5 17.6 10.6 12 5 6.4 6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19Z"/></svg>`;

      const EXT = {
        "image/png": "png",
        "image/jpeg": "jpg",
        "image/webp": "webp",
        "image/gif": "gif",
        "image/avif": "avif",
      };

      const FORMAT_LABEL = {
        original: "原格式",
        webp: "WebP",
        jpeg: "JPEG",
        png: "PNG",
      };

      // 裁剪比例：null 表示不裁
      const RATIOS = {
        original: null,
        "1:1": 1,
        "4:3": 4 / 3,
        "3:4": 3 / 4,
        "16:9": 16 / 9,
        "9:16": 9 / 16,
      };

      const RATIO_LABEL = {
        original: "原比例",
        "1:1": "1:1",
        "4:3": "4:3",
        "3:4": "3:4",
        "16:9": "16:9",
        "9:16": "9:16",
      };

      // 每张图各自的编辑参数
      const EDIT_DEFAULTS = {
        format: "original",
        quality: 85,
        width: null,
        rotate: 0,
        flipH: false,
        flipV: false,
        brightness: 100,
        contrast: 100,
        saturate: 100,
        cropRatio: "original",
        radius: 0,
      };

      const state = { items: [], seq: 0, activeId: null };

      const drop = document.getElementById("img-drop");
      const input = document.getElementById("img-input");
      const stripEl = document.getElementById("img-strip");
      const stageEl = document.getElementById("img-stage");
      const previewEl = document.getElementById("img-preview");
      const panelEl = document.getElementById("img-panel");
      const statusEl = document.getElementById("status");
      const btnExportEdited = document.getElementById("btn-export-edited");
      const btnExportAll = document.getElementById("btn-export-all");

      const itemOf = (id) => state.items.find((i) => i.id === id) || null;
      const activeItem = () => itemOf(state.activeId);

      // ── 尺寸与绘制 ────────────────────────────────────

      // 某张图在“原始像素坐标系”下要取的区域
      function cropRect(item) {
        const w0 = item.w0;
        const h0 = item.h0;
        // 手动裁剪（归一化坐标）优先于全局比例
        if (item.crop) {
          return {
            x: item.crop.x * w0,
            y: item.crop.y * h0,
            w: Math.max(1, item.crop.w * w0),
            h: Math.max(1, item.crop.h * h0),
          };
        }
        const r = RATIOS[item.edit.cropRatio];
        if (!r) return { x: 0, y: 0, w: w0, h: h0 };
        const cur = w0 / h0;
        let cw;
        let ch;
        if (cur > r) {
          ch = h0;
          cw = h0 * r;
        } else {
          cw = w0;
          ch = w0 / r;
        }
        return { x: (w0 - cw) / 2, y: (h0 - ch) / 2, w: cw, h: ch };
      }

      function outSize(item) {
        const c = cropRect(item);
        const e = item.edit;
        let w = c.w;
        let h = c.h;
        if (e.width && e.width > 0) {
          const k = e.width / w;
          w = e.width;
          h = h * k;
        }
        w = Math.max(1, Math.round(w));
        h = Math.max(1, Math.round(h));
        if (e.rotate % 180 !== 0) {
          const t = w;
          w = h;
          h = t;
        }
        return { w, h };
      }

      function roundRectPath(ctx, x, y, w, h, r) {
        const rr = Math.min(r, w / 2, h / 2);
        ctx.moveTo(x + rr, y);
        ctx.lineTo(x + w - rr, y);
        ctx.arcTo(x + w, y, x + w, y + rr, rr);
        ctx.lineTo(x + w, y + h - rr);
        ctx.arcTo(x + w, y + h, x + w - rr, y + h, rr);
        ctx.lineTo(x + rr, y + h);
        ctx.arcTo(x, y + h, x, y + h - rr, rr);
        ctx.lineTo(x, y + rr);
        ctx.arcTo(x, y, x + rr, y, rr);
        ctx.closePath();
      }

      function drawItem(canvas, item, maxEdge) {
        const e = item.edit;
        const { w, h } = outSize(item);
        const s = maxEdge ? Math.min(1, maxEdge / Math.max(w, h)) : 1;
        const cw = Math.max(1, Math.round(w * s));
        const ch = Math.max(1, Math.round(h * s));
        canvas.width = cw;
        canvas.height = ch;
        const ctx = canvas.getContext("2d");
        ctx.clearRect(0, 0, cw, ch);

        // 圆角：先裁剪路径，再画内容
        const radius = e.radius > 0 ? (Math.min(cw, ch) * e.radius) / 100 : 0;
        if (radius > 0) {
          ctx.beginPath();
          if (typeof ctx.roundRect === "function") {
            ctx.roundRect(0, 0, cw, ch, radius);
          } else {
            roundRectPath(ctx, 0, 0, cw, ch, radius);
          }
          ctx.clip();
        }

        const rotated = e.rotate % 180 !== 0;
        const bw = rotated ? ch : cw;
        const bh = rotated ? cw : ch;
        const src = cropRect(item);

        ctx.save();
        ctx.filter = `brightness(${e.brightness}%) contrast(${e.contrast}%) saturate(${e.saturate}%)`;
        ctx.translate(cw / 2, ch / 2);
        ctx.rotate((e.rotate * Math.PI) / 180);
        ctx.scale(e.flipH ? -1 : 1, e.flipV ? -1 : 1);
        ctx.drawImage(item.bitmap, src.x, src.y, src.w, src.h, -bw / 2, -bh / 2, bw, bh);
        ctx.restore();
      }

      function mimeOf(item) {
        const f = item.edit.format;
        if (f === "original") {
          if (item.mime === "image/png" || item.mime === "image/webp") {
            return item.mime;
          }
          return "image/jpeg";
        }
        return "image/" + f;
      }

      // ── 状态判断 ──────────────────────────────────────

      function isEdited(item) {
        if (item.drawn) return true;
        if (item.crop) return true;
        for (const k in EDIT_DEFAULTS) {
          if (item.edit[k] !== EDIT_DEFAULTS[k]) return true;
        }
        return false;
      }

      // ── 界面刷新 ──────────────────────────────────────

      function syncStripState() {
        for (const el of stripEl.querySelectorAll(".img-thumb")) {
          const it = itemOf(el.dataset.id);
          el.classList.toggle("is-active", el.dataset.id === state.activeId);
          el.classList.toggle("is-edited", it ? isEdited(it) : false);
        }
      }

      function syncActions() {
        const total = state.items.length;
        const edited = state.items.filter(isEdited).length;
        btnExportEdited.disabled = edited === 0;
        btnExportAll.disabled = total === 0;
        btnExportEdited.textContent = edited
          ? `下载修改的 (${edited})`
          : "下载修改的";
        if (total) {
          statusEl.textContent = `共 ${total} 张，已修改 ${edited} 张`;
        } else {
          statusEl.textContent = "还没有添加图片";
        }
      }

      function drawPreview() {
        const item = activeItem();
        if (!item) return;
        // 绘制中画布显示的是绘制内容，别被预览覆盖
        if (!draw.active) drawItem(previewEl, item, 1400);
        const o = outSize(item);
        const ext = EXT[mimeOf(item)] || "png";
        document.getElementById("stage-name").textContent = item.name;
        document.getElementById("stage-meta").textContent =
          `${item.w0}×${item.h0} → ${o.w}×${o.h} · ${ext}`;
      }

      function drawThumbs() {
        for (const item of state.items) {
          if (item.thumb) drawItem(item.thumb, item, 160);
        }
      }

      function syncLayout() {
        const has = state.items.length > 0;
        stageEl.hidden = !has;
        stripEl.hidden = !has;
        drop.hidden = has;
        panelEl.dataset.empty = has ? "0" : "1";
      }

      let rafId = 0;
      function scheduleRedraw() {
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          drawThumbs();
          drawPreview();
          syncStripState();
          syncActions();
          syncWidthLabel();
        });
      }

      // ── 面板与当前图同步 ──────────────────────────────

      function syncWidthLabel() {
        const el = document.getElementById("val-width");
        const item = activeItem();
        if (!item || !item.edit.width) {
          el.textContent = "原始";
          return;
        }
        const o = outSize(item);
        el.textContent = `${o.w} × ${o.h}`;
      }

      function syncPanel() {
        const item = activeItem();
        const e = item ? item.edit : EDIT_DEFAULTS;

        for (const btn of document.querySelectorAll("#seg-format button")) {
          btn.setAttribute("aria-pressed", String(btn.dataset.format === e.format));
        }
        document.getElementById("val-format").textContent =
          FORMAT_LABEL[e.format] || "原格式";

        const lossy = e.format !== "png";
        const qInput = document.getElementById("in-quality");
        qInput.disabled = !lossy;
        qInput.value = String(e.quality);
        document.getElementById("val-quality").textContent = `${e.quality}%`;
        document.getElementById("quality-section").style.opacity = lossy ? "1" : "0.55";
        document.getElementById("quality-note").textContent = lossy
          ? "数值越低体积越小"
          : "PNG 为无损格式，忽略质量";

        document.getElementById("in-width").value = e.width ? String(e.width) : "";

        for (const btn of document.querySelectorAll("#seg-crop button")) {
          btn.setAttribute("aria-pressed", String(btn.dataset.ratio === e.cropRatio));
        }
        document.getElementById("val-crop").textContent =
          RATIO_LABEL[e.cropRatio] || "原比例";

        document.getElementById("btn-flip-h").setAttribute("aria-pressed", String(e.flipH));
        document.getElementById("btn-flip-v").setAttribute("aria-pressed", String(e.flipV));

        for (const [id, key, outId] of [
          ["in-bright", "brightness", "val-bright"],
          ["in-contrast", "contrast", "val-contrast"],
          ["in-saturate", "saturate", "val-saturate"],
          ["in-radius", "radius", "val-radius"],
        ]) {
          document.getElementById(id).value = String(e[key]);
          document.getElementById(outId).textContent = `${e[key]}%`;
        }

        syncWidthLabel();
      }

      function applyEdit(patch) {
        const item = activeItem();
        if (!item) return;
        Object.assign(item.edit, patch);
        scheduleRedraw();
      }

      // ── 缩略图条 ──────────────────────────────────────

      function renderStrip() {
        stripEl.innerHTML = "";
        for (const item of state.items) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "img-thumb";
          b.dataset.id = item.id;
          b.title = item.name;

          const c = document.createElement("canvas");
          b.appendChild(c);

          const del = document.createElement("span");
          del.className = "img-thumb-del";
          del.setAttribute("role", "button");
          del.setAttribute("aria-label", "移除这张");
          del.innerHTML = ICON_X;
          b.appendChild(del);

          item.thumb = c;
          stripEl.appendChild(b);
        }

        const add = document.createElement("button");
        add.type = "button";
        add.className = "img-thumb-add";
        add.title = "添加图片";
        add.setAttribute("aria-label", "添加图片");
        add.textContent = "+";
        add.addEventListener("click", () => input.click());
        stripEl.appendChild(add);

        syncStripState();
      }

      function scrollStripToActive() {
        const el = stripEl.querySelector(".img-thumb.is-active");
        if (!el) return;
        const r = el.getBoundingClientRect();
        const sr = stripEl.getBoundingClientRect();
        if (r.left < sr.left) {
          stripEl.scrollLeft -= sr.left - r.left + 10;
        } else if (r.right > sr.right) {
          stripEl.scrollLeft += r.right - sr.right + 10;
        }
      }

      function setActive(id) {
        if (draw.active && draw.item && draw.item.id !== id) {
          endDraw(false);
          statusEl.textContent = "切换了图片，本次绘制已取消";
        }
        state.activeId = id;
        syncStripState();
        syncPanel();
        drawPreview();
        scrollStripToActive();
      }

      stripEl.addEventListener("click", (e) => {
        const thumb = e.target.closest(".img-thumb");
        if (!thumb) return;
        const id = thumb.dataset.id;
        if (e.target.closest(".img-thumb-del")) {
          removeItem(id);
          return;
        }
        setActive(id);
      });

      function removeItem(id) {
        const idx = state.items.findIndex((i) => i.id === id);
        if (idx < 0) return;
        if (draw.active && draw.item && draw.item.id === id) endDraw(false);
        state.items[idx].bitmap.close?.();
        state.items.splice(idx, 1);
        if (state.activeId === id) {
          const next = state.items[Math.min(idx, state.items.length - 1)];
          state.activeId = next ? next.id : null;
        }
        renderStrip();
        syncLayout();
        syncPanel();
        scheduleRedraw();
      }

      // ── 载入图片 ──────────────────────────────────────

      async function decode(file) {
        try {
          return await createImageBitmap(file, { imageOrientation: "from-image" });
        } catch {
          try {
            return await createImageBitmap(file);
          } catch {
            const url = URL.createObjectURL(file);
            const img = new Image();
            img.src = url;
            await img.decode();
            const bmp = await createImageBitmap(img);
            URL.revokeObjectURL(url);
            return bmp;
          }
        }
      }

      let loading = false;
      async function addFiles(files) {
        if (loading) return;
        loading = true;
        statusEl.textContent = "正在读取图片…";
        let firstAdded = null;
        for (const file of Array.from(files)) {
          if (!file.type.startsWith("image/")) continue;
          try {
            const bitmap = await decode(file);
            const item = {
              id: `i${++state.seq}`,
              name: file.name,
              mime: file.type || "image/png",
              bitmap,
              w0: bitmap.width,
              h0: bitmap.height,
              crop: null,
              edit: { ...EDIT_DEFAULTS },
            };
            state.items.push(item);
            if (!firstAdded) firstAdded = item;
          } catch (err) {
            console.warn("[image-tool] 无法读取", file.name, err);
          }
        }
        loading = false;

        if (!state.items.length) {
          statusEl.textContent = "没有读取到可用的图片";
          return;
        }

        renderStrip();
        syncLayout();
        // 新加的图片直接切成当前编辑对象
        setActive(firstAdded ? firstAdded.id : state.items[0].id);
        scheduleRedraw();
        if (!firstAdded) statusEl.textContent = "没有读取到可用的图片";
      }

      drop.addEventListener("click", () => input.click());
      drop.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          input.click();
        }
      });

      input.addEventListener("change", () => {
        if (input.files?.length) addFiles(input.files);
        input.value = "";
      });

      // 页面级拖入
      let dragDepth = 0;
      let overlay = null;
      window.addEventListener("dragenter", (e) => {
        if (!e.dataTransfer?.types.includes("Files")) return;
        dragDepth++;
        drop.classList.add("is-over");
        if (!overlay) {
          overlay = document.createElement("div");
          overlay.className = "img-drop-overlay";
          overlay.innerHTML = "<span>松手即可添加图片</span>";
          document.body.appendChild(overlay);
        }
      });
      window.addEventListener("dragleave", (e) => {
        if (!e.dataTransfer?.types.includes("Files")) return;
        dragDepth = Math.max(0, dragDepth - 1);
        if (dragDepth === 0) {
          drop.classList.remove("is-over");
          overlay?.remove();
          overlay = null;
        }
      });
      window.addEventListener("dragover", (e) => {
        if (e.dataTransfer?.types.includes("Files")) e.preventDefault();
      });
      window.addEventListener("drop", (e) => {
        if (!e.dataTransfer?.types.includes("Files")) return;
        e.preventDefault();
        dragDepth = 0;
        drop.classList.remove("is-over");
        overlay?.remove();
        overlay = null;
        if (e.dataTransfer.files?.length) addFiles(e.dataTransfer.files);
      });

      // ── 面板交互 ──────────────────────────────────────

      document.getElementById("seg-format").addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-format]");
        if (!btn) return;
        applyEdit({ format: btn.dataset.format });
        syncPanel();
      });

      document.getElementById("in-quality").addEventListener("input", (e) => {
        const v = Number(e.target.value);
        document.getElementById("val-quality").textContent = `${v}%`;
        applyEdit({ quality: v });
      });

      document.getElementById("in-width").addEventListener("input", (e) => {
        const v = Number(e.target.value);
        applyEdit({ width: v > 0 ? Math.round(v) : null });
        syncWidthLabel();
      });

      document.getElementById("seg-crop").addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-ratio]");
        if (!btn) return;
        applyEdit({ cropRatio: btn.dataset.ratio });
        syncPanel();
      });

      document.getElementById("btn-rot-l").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        applyEdit({ rotate: (item.edit.rotate + 270) % 360 });
      });

      document.getElementById("btn-rot-r").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        applyEdit({ rotate: (item.edit.rotate + 90) % 360 });
      });

      for (const [id, key] of [
        ["btn-flip-h", "flipH"],
        ["btn-flip-v", "flipV"],
      ]) {
        document.getElementById(id).addEventListener("click", () => {
          const item = activeItem();
          if (!item) return;
          applyEdit({ [key]: !item.edit[key] });
          syncPanel();
        });
      }

      for (const [id, key, outId] of [
        ["in-bright", "brightness", "val-bright"],
        ["in-contrast", "contrast", "val-contrast"],
        ["in-saturate", "saturate", "val-saturate"],
        ["in-radius", "radius", "val-radius"],
      ]) {
        document.getElementById(id).addEventListener("input", (e) => {
          const v = Number(e.target.value);
          document.getElementById(outId).textContent = `${v}%`;
          applyEdit({ [key]: v });
        });
      }

      document.getElementById("btn-reset").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        item.crop = null;
        item.edit = { ...EDIT_DEFAULTS };
        syncPanel();
        scheduleRedraw();
        statusEl.textContent = "已重置这张";
      });

      document.getElementById("btn-apply-all").addEventListener("click", () => {
        const src = activeItem();
        if (!src) return;
        const base = { ...src.edit };
        let n = 0;
        for (const it of state.items) {
          if (it === src) continue;
          it.edit = { ...base };
          n++;
        }
        scheduleRedraw();
        statusEl.textContent = n
          ? `已把当前设置应用到其余 ${n} 张（手动裁剪不复制）`
          : "只有一张图片，无需应用";
      });

      // ── 手动裁剪 ──────────────────────────────────────

      const MIN_BOX = 20;
      let closeCropper = null;

      function openCropper(item) {
        if (closeCropper) closeCropper();
        if (!item) return;

        const layer = document.createElement("div");
        layer.className = "crop-layer";
        layer.innerHTML = `
          <div class="crop-head">
            <strong>裁剪</strong>
            <span class="crop-name"></span>
            <span class="crop-tip">拖角缩放 · 框内移动 · 空白处重新框选</span>
          </div>
          <div class="crop-stage">
            <div class="crop-frame">
              <canvas class="crop-canvas"></canvas>
              <div class="crop-box">
                <i class="crop-handle" data-h="nw"></i>
                <i class="crop-handle" data-h="ne"></i>
                <i class="crop-handle" data-h="sw"></i>
                <i class="crop-handle" data-h="se"></i>
                <em class="crop-size"></em>
              </div>
            </div>
          </div>
          <div class="crop-bar">
            <button type="button" class="crop-btn" data-act="reset">重置</button>
            <button type="button" class="crop-btn" data-act="ratio">按当前比例</button>
            <span class="crop-spacer"></span>
            <button type="button" class="crop-btn" data-act="cancel">取消</button>
            <button type="button" class="crop-btn crop-btn-primary" data-act="apply">应用</button>
          </div>
        `;
        document.body.appendChild(layer);
        layer.querySelector(".crop-name").textContent = item.name;

        // 锁住底层滚动，避免关闭后页面位置跑掉
        const prevOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        const close = () => {
          document.body.style.overflow = prevOverflow;
          layer.remove();
          if (closeCropper === close) closeCropper = null;
        };
        closeCropper = close;

        const stage = layer.querySelector(".crop-stage");
        const frame = layer.querySelector(".crop-frame");
        const canvas = layer.querySelector(".crop-canvas");
        const boxEl = layer.querySelector(".crop-box");
        const sizeEl = layer.querySelector(".crop-size");

        // 按可用空间等比铺开
        const cs = getComputedStyle(stage);
        const availW =
          stage.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        const availH =
          stage.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        const imgRatio = item.w0 / item.h0;
        let dispW = Math.max(80, availW);
        let dispH = dispW / imgRatio;
        if (dispH > availH) {
          dispH = Math.max(80, availH);
          dispW = dispH * imgRatio;
        }
        dispW = Math.round(dispW);
        dispH = Math.round(dispH);

        frame.style.width = dispW + "px";
        frame.style.height = dispH + "px";
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.round(dispW * dpr);
        canvas.height = Math.round(dispH * dpr);
        canvas.style.width = dispW + "px";
        canvas.style.height = dispH + "px";
        const cctx = canvas.getContext("2d");
        cctx.imageSmoothingQuality = "high";
        cctx.drawImage(item.bitmap, 0, 0, canvas.width, canvas.height);

        function ratioBox() {
          const r = RATIOS[item.edit.cropRatio];
          if (!r) return { x: 0, y: 0, w: dispW, h: dispH };
          let w = dispW;
          let h = w / r;
          if (h > dispH) {
            h = dispH;
            w = h * r;
          }
          return { x: (dispW - w) / 2, y: (dispH - h) / 2, w, h };
        }

        function initialBox() {
          if (item.crop) {
            return {
              x: item.crop.x * dispW,
              y: item.crop.y * dispH,
              w: Math.max(MIN_BOX, item.crop.w * dispW),
              h: Math.max(MIN_BOX, item.crop.h * dispH),
            };
          }
          return ratioBox();
        }

        let box = initialBox();

        function paint() {
          boxEl.style.left = box.x + "px";
          boxEl.style.top = box.y + "px";
          boxEl.style.width = box.w + "px";
          boxEl.style.height = box.h + "px";
          const cw = Math.max(1, Math.round((box.w / dispW) * item.w0));
          const ch = Math.max(1, Math.round((box.h / dispH) * item.h0));
          sizeEl.textContent = `${cw} × ${ch}`;
        }
        paint();

        let drag = null;

        function local(e) {
          const r = frame.getBoundingClientRect();
          return { x: e.clientX - r.left, y: e.clientY - r.top };
        }

        frame.addEventListener("pointerdown", (e) => {
          if (e.button !== 0 && e.button !== undefined) return;
          e.preventDefault();
          const p = local(e);
          const handle = e.target.closest(".crop-handle");
          if (handle) {
            const c = handle.dataset.h;
            drag = {
              mode: "handle",
              corner: c,
              anchor: {
                nw: { x: box.x + box.w, y: box.y + box.h },
                ne: { x: box.x, y: box.y + box.h },
                sw: { x: box.x + box.w, y: box.y },
                se: { x: box.x, y: box.y },
              }[c],
            };
          } else if (e.target.closest(".crop-box")) {
            drag = { mode: "move", start: p, box0: { ...box } };
          } else {
            drag = { mode: "new", start: p, dirX: 1, dirY: 1, first: true };
          }
          frame.setPointerCapture?.(e.pointerId);
        });

        frame.addEventListener("pointermove", (e) => {
          if (!drag) return;
          const p = local(e);

          if (drag.mode === "move") {
            const maxX = dispW - drag.box0.w;
            const maxY = dispH - drag.box0.h;
            box = {
              w: drag.box0.w,
              h: drag.box0.h,
              x: Math.min(maxX, Math.max(0, drag.box0.x + (p.x - drag.start.x))),
              y: Math.min(maxY, Math.max(0, drag.box0.y + (p.y - drag.start.y))),
            };
            paint();
            return;
          }

          if (drag.mode === "handle") {
            const a = drag.anchor;
            const c = drag.corner;
            let w = Math.abs(p.x - a.x);
            let h = Math.abs(p.y - a.y);
            const r = RATIOS[item.edit.cropRatio];
            if (r) {
              // 取更“大”的方向定尺寸，保证指针落在框内
              if (h * r > w) w = h * r;
              h = w / r;
            }
            w = Math.max(MIN_BOX, w);
            h = Math.max(MIN_BOX, h);
            const maxW = c.includes("w") ? a.x : dispW - a.x;
            const maxH = c.includes("n") ? a.y : dispH - a.y;
            const k = Math.min(1, maxW / w, maxH / h);
            w *= k;
            h *= k;
            box = {
              w,
              h,
              x: c.includes("w") ? a.x - w : a.x,
              y: c.includes("n") ? a.y - h : a.y,
            };
            paint();
            return;
          }

          // 新建选框
          if (drag.first) {
            drag.first = false;
            drag.dirX = p.x >= drag.start.x ? 1 : -1;
            drag.dirY = p.y >= drag.start.y ? 1 : -1;
          }
          let w = Math.abs(p.x - drag.start.x);
          let h = Math.abs(p.y - drag.start.y);
          const r = RATIOS[item.edit.cropRatio];
          if (r) {
            if (h * r > w) w = h * r;
            h = w / r;
          }
          w = Math.max(MIN_BOX, Math.min(w, dispW));
          h = Math.max(MIN_BOX, Math.min(h, dispH));
          let x = drag.dirX > 0 ? drag.start.x : drag.start.x - w;
          let y = drag.dirY > 0 ? drag.start.y : drag.start.y - h;
          x = Math.min(Math.max(0, x), dispW - w);
          y = Math.min(Math.max(0, y), dispH - h);
          box = { x, y, w, h };
          paint();
        });

        const endDrag = () => {
          drag = null;
        };
        frame.addEventListener("pointerup", endDrag);
        frame.addEventListener("pointercancel", endDrag);

        layer.addEventListener("click", (e) => {
          const btn = e.target.closest(".crop-btn");
          if (!btn) return;
          const act = btn.dataset.act;

          if (act === "cancel") {
            close();
            return;
          }

          if (act === "reset") {
            item.crop = null;
            box = ratioBox();
            paint();
            return;
          }

          if (act === "ratio") {
            box = ratioBox();
            paint();
            return;
          }

          if (act === "apply") {
            const isFull =
              box.x <= 0.5 &&
              box.y <= 0.5 &&
              box.w >= dispW - 1 &&
              box.h >= dispH - 1;
            item.crop = isFull
              ? null
              : {
                  x: box.x / dispW,
                  y: box.y / dispH,
                  w: box.w / dispW,
                  h: box.h / dispH,
                };
            const label = sizeEl.textContent;
            close();
            scheduleRedraw();
            statusEl.textContent = isFull ? "已取消裁剪" : `已裁剪为 ${label}`;
          }
        });
      }

      document.getElementById("btn-crop-one").addEventListener("click", () => {
        openCropper(activeItem());
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && closeCropper) closeCropper();
      });

      // ── 导出 ──────────────────────────────────────────

      function toBlob(canvas, mime, quality) {
        return new Promise((resolve, reject) => {
          canvas.toBlob(
            (b) => (b ? resolve(b) : reject(new Error("toBlob 返回空"))),
            mime,
            mime === "image/png" ? undefined : quality / 100,
          );
        });
      }

      async function renderBlob(item) {
        const canvas = document.createElement("canvas");
        drawItem(canvas, item, null);
        const mime = mimeOf(item);

        if (mime === "image/jpeg") {
          // JPEG 没有透明通道，先铺白底，否则透明区域会变黑
          const flat = document.createElement("canvas");
          flat.width = canvas.width;
          flat.height = canvas.height;
          const fctx = flat.getContext("2d");
          fctx.fillStyle = "#ffffff";
          fctx.fillRect(0, 0, flat.width, flat.height);
          fctx.drawImage(canvas, 0, 0);
          return { blob: await toBlob(flat, mime, item.edit.quality), mime };
        }
        return { blob: await toBlob(canvas, mime, item.edit.quality), mime };
      }

      function baseName(name) {
        return name.replace(/\.[^./\\]+$/, "") || "image";
      }

      function saveBlob(blob, filename) {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 6000);
      }

      async function exportList(list) {
        if (!list.length) return;
        const total = list.length;
        for (let i = 0; i < total; i++) {
          statusEl.textContent = `正在导出 ${i + 1}/${total}…`;
          try {
            const { blob, mime } = await renderBlob(list[i]);
            const ext = EXT[mime] || "png";
            saveBlob(blob, `${baseName(list[i].name)}.${ext}`);
          } catch (err) {
            console.warn("[image-tool] 导出失败", list[i].name, err);
          }
          // 多张连续下载之间留间隔，避免浏览器拦截
          if (i < total - 1) await new Promise((r) => setTimeout(r, 320));
        }
        statusEl.textContent = `已导出 ${total} 张`;
      }

      document.getElementById("btn-save-one").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        exportList([item]);
      });

      btnExportEdited.addEventListener("click", () => {
        exportList(state.items.filter(isEdited));
      });

      btnExportAll.addEventListener("click", () => {
        exportList([...state.items]);
      });


      // ── 面板页签 ──────────────────────────────────────

      const tabBar = panelEl.querySelector(".panel-tabs");

      function switchTab(name: string) {
        if (!tabBar) return;
        for (const b of tabBar.querySelectorAll<HTMLButtonElement>(".panel-tab")) {
          b.setAttribute("aria-selected", String(b.dataset.tab === name));
        }
        for (const page of panelEl.querySelectorAll<HTMLElement>(".panel-page")) {
          page.hidden = page.dataset.page !== name;
        }
      }

      tabBar?.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
          ".panel-tab",
        );
        if (!btn?.dataset.tab) return;
        // 点「绘制」直接把当前图切进绘制状态，布局还是原来那一套
        if (btn.dataset.tab === "draw" && !draw.active) {
          const item = activeItem();
          if (item) {
            startDraw(item);
            return;
          }
        }
        switchTab(btn.dataset.tab);
      });

      // ── 编辑画布（Fabric 驱动） ────────────────────────
      //
      // 底图单独放一层普通 canvas（始终保持原图分辨率），素材都放在上层 Fabric
      // 画布里：选中、拖动、四角缩放、旋转、图层顺序全交给 Fabric 处理。
      // 导出时把两层合成：底图原样贴回，对象层按 1/显示缩放 重新渲染，所以
      // 文字和形状在导出图里仍是矢量清晰的，不会被放糊。

      const GRADIENT_PRESETS = [
        { c1: "#ff9a3c", c2: "#ff5f6d", angle: 45 },
        { c1: "#00c6ff", c2: "#0072ff", angle: 135 },
        { c1: "#7bf1a8", c2: "#1e90ff", angle: 90 },
        { c1: "#c471ed", c2: "#f64f59", angle: 30 },
      ];

      const SWATCHES = [
        "#ffffff",
        "#1a1a1c",
        "#ff4d4f",
        "#ff9a3c",
        "#ffd60a",
        "#2ecc71",
        "#00b4d8",
        "#4361ee",
        "#9b5de5",
        "#ff70a6",
      ];

      const TEXT_FONT =
        '"PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif';

      const drawPage = panelEl!.querySelector<HTMLElement>('.panel-page[data-page="draw"]');
      const drawHolder = document.getElementById("draw-holder") as HTMLElement;
      const drawInner = document.getElementById("draw-inner") as HTMLElement;
      const drawBase = document.getElementById("draw-base") as HTMLCanvasElement;
      const drawCanvasEl = document.getElementById("img-draw") as HTMLCanvasElement;
      const drawHintEl = document.getElementById("draw-hint") as HTMLElement;
      const stageOpsEl = document.getElementById("stage-draw-ops") as HTMLElement;
      const btnDrawOne = document.getElementById("btn-draw-one") as HTMLButtonElement;
      const btnCropOne = document.getElementById("btn-crop-one") as HTMLButtonElement;
      const btnSaveOne = document.getElementById("btn-save-one") as HTMLButtonElement;
      const drawTextInput = document.getElementById("draw-text") as HTMLInputElement;

      const pen = {
        tool: "select" as "select" | "text" | "shape" | "pen" | "bucket",
        shape: "rect",
        mode: "solid" as "solid" | "gradient",
        gtype: "linear" as "linear" | "radial",
        c1: "#ff4d4f",
        c2: "#ffd60a",
        angle: 45,
        text: "",
        sizePct: 8,
        bold: true,
        italic: false,
        brush: 8,
      };

      type DrawSnap = { json: string; bg: HTMLCanvasElement };

      const draw = {
        active: false,
        item: null as any,
        canvas: null as any,
        base: null as HTMLCanvasElement | null,
        W: 0,
        H: 0,
        dispW: 0,
        dispH: 0,
        z: 1,
        pending: null as DrawSnap | null,
        undo: [] as DrawSnap[],
        redo: [] as DrawSnap[],
      };

      // 色板与渐变预设按钮
      const swatchBox = drawPage?.querySelector<HTMLElement>('.swatches[data-role="swatches"]');
      if (swatchBox) {
        swatchBox.innerHTML = SWATCHES.map(
          (c) =>
            `<button class="swatch" type="button" data-swatch="${c}" style="background:${c}" title="${c}" aria-label="${c}"></button>`,
        ).join("");
      }
      const presetBox = drawPage?.querySelector<HTMLElement>('.swatches[data-when="gradient"]');
      if (presetBox) {
        presetBox.innerHTML = GRADIENT_PRESETS.map(
          (g, i) =>
            `<button class="swatch" type="button" data-gpreset="${i}" style="background:linear-gradient(135deg,${g.c1},${g.c2})" title="渐变预设 ${i + 1}" aria-label="渐变预设 ${i + 1}"></button>`,
        ).join("");
      }

      function copyCanvas(src: HTMLCanvasElement) {
        const c = document.createElement("canvas");
        c.width = src.width;
        c.height = src.height;
        c.getContext("2d")!.drawImage(src, 0, 0);
        return c;
      }

      function hexToRgb(hex: string) {
        const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return m
          ? { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) }
          : { r: 0, g: 0, b: 0 };
      }

      // ── 颜色与渐变 ───────────────────────────────────

      function makeGradient(w: number, h: number) {
        const rad = (pen.angle * Math.PI) / 180;
        const cx = w / 2;
        const cy = h / 2;
        const span = Math.max(w, h) / 2 || 1;
        if (pen.gtype === "radial") {
          return new Gradient({
            type: "radial",
            coords: { x1: cx, y1: cy, r1: 0, x2: cx, y2: cy, r2: span },
            colorStops: [
              { offset: 0, color: pen.c1 },
              { offset: 1, color: pen.c2 },
            ],
          });
        }
        return new Gradient({
          type: "linear",
          coords: {
            x1: cx - Math.cos(rad) * span,
            y1: cy - Math.sin(rad) * span,
            x2: cx + Math.cos(rad) * span,
            y2: cy + Math.sin(rad) * span,
          },
          colorStops: [
            { offset: 0, color: pen.c1 },
            { offset: 1, color: pen.c2 },
          ],
        });
      }

      function fillFor(o: any) {
        if (pen.mode === "solid") return pen.c1;
        const w = Math.max(1, (o?.width || 1) * (o?.scaleX || 1));
        const h = Math.max(1, (o?.height || 1) * (o?.scaleY || 1));
        return makeGradient(w, h);
      }

      function isTextObj(o: any) {
        return !!o && (o.type === "i-text" || o.type === "textbox" || o.type === "text");
      }

      function applyStyle(o: any) {
        if (!o) return;
        if (o.type === "line") {
          o.set({ stroke: pen.mode === "solid" ? pen.c1 : pen.c2 });
        } else if (isTextObj(o)) {
          o.set({
            fill: fillFor(o),
            fontWeight: pen.bold ? 700 : 400,
            fontStyle: pen.italic ? "italic" : "normal",
          });
        } else {
          o.set({ fill: fillFor(o) });
        }
        o.set("dirty", true);
      }

      function selectedObject() {
        return draw.canvas?.getActiveObject() || null;
      }

      // ── 素材：形状与文字 ─────────────────────────────

      function placeAt(o: any, cx: number, cy: number) {
        o.set({ left: cx, top: cy });
        o.setPositionByOrigin(new Point(cx, cy), "center", "center");
        return o;
      }

      function starPoints(r: number) {
        const pts: { x: number; y: number }[] = [];
        for (let i = 0; i < 10; i++) {
          const rad = i % 2 === 0 ? r : r * 0.42;
          const a = -Math.PI / 2 + (i * Math.PI) / 5;
          pts.push({ x: r + Math.cos(a) * rad, y: r + Math.sin(a) * rad });
        }
        return pts;
      }

      function arrowPoints(s: number) {
        const t = s * 0.28;
        const hh = s * 0.16;
        return [
          { x: 0, y: s / 2 - hh },
          { x: s - t, y: s / 2 - hh },
          { x: s - t, y: s * 0.1 },
          { x: s, y: s / 2 },
          { x: s - t, y: s * 0.9 },
          { x: s - t, y: s / 2 + hh },
          { x: 0, y: s / 2 + hh },
        ];
      }

      function baseSize() {
        return Math.max(40, Math.round(Math.min(draw.dispW || 520, draw.dispH || 420) * 0.28));
      }

      function newShape(kind: string, cx: number, cy: number) {
        const s = baseSize();
        let o: any;
        if (kind === "rect") {
          o = new Rect({ width: s, height: Math.round(s * 0.72), rx: s * 0.05, ry: s * 0.05 });
        } else if (kind === "circle") {
          o = new Circle({ radius: s / 2 });
        } else if (kind === "triangle") {
          o = new Triangle({ width: s, height: Math.round(s * 0.88) });
        } else if (kind === "diamond") {
          o = new Polygon([
            { x: s / 2, y: 0 },
            { x: s, y: s / 2 },
            { x: s / 2, y: s },
            { x: 0, y: s / 2 },
          ]);
        } else if (kind === "star") {
          o = new Polygon(starPoints(s / 2));
        } else if (kind === "arrow") {
          o = new Polygon(arrowPoints(s));
        } else {
          o = new Line([cx - s / 2, cy, cx + s / 2, cy], {
            stroke: pen.mode === "solid" ? pen.c1 : pen.c2,
            strokeWidth: Math.max(2, Math.round(s * 0.055)),
            strokeLineCap: "round",
          });
          o.set({ strokeUniform: true });
          o.setPositionByOrigin(new Point(cx, cy), "center", "center");
          draw.canvas.add(o);
          return o;
        }
        o.set({ fill: pen.mode === "solid" ? pen.c1 : makeGradient(s, s) });
        placeAt(o, cx, cy);
        draw.canvas.add(o);
        return o;
      }

      function textSize() {
        return Math.max(10, Math.round(((draw.dispH || 600) * pen.sizePct) / 100));
      }

      function newText(cx: number, cy: number, value?: string) {
        const size = textSize();
        const txt = String(value ?? pen.text).trim() || "双击改文字";
        const o = new IText(txt, {
          fontFamily: TEXT_FONT,
          fontSize: size,
          fontWeight: pen.bold ? 700 : 400,
          fontStyle: pen.italic ? "italic" : "normal",
          fill: pen.mode === "solid" ? pen.c1 : makeGradient(size * txt.length, size),
          originX: "center",
          originY: "center",
          left: cx,
          top: cy,
        });
        draw.canvas.add(o);
        return o;
      }

      // 新对象放下去后可能有一半在画布外，往回推一把，避免看起来「丢了」
      function keepInside(o: any) {
        if (!o || !draw.dispW || !draw.dispH) return;
        const m = 2;
        const b = o.getBoundingRect();
        let dx = 0;
        let dy = 0;
        if (b.left < m) dx = m - b.left;
        else if (b.left + b.width > draw.dispW - m) dx = draw.dispW - m - (b.left + b.width);
        if (b.top < m) dy = m - b.top;
        else if (b.top + b.height > draw.dispH - m) dy = draw.dispH - m - (b.top + b.height);
        if (b.width > draw.dispW) dx = m - b.left;
        if (b.height > draw.dispH) dy = m - b.top;
        if (dx || dy) {
          o.set({ left: o.left + dx, top: o.top + dy });
          o.setCoords();
        }
      }

      // ── 底图：缩放显示 + 填色 ────────────────────────

      function paintBase() {
        if (!draw.base) return;
        const ctx = drawBase.getContext("2d")!;
        ctx.clearRect(0, 0, drawBase.width, drawBase.height);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(draw.base, 0, 0, drawBase.width, drawBase.height);
      }

      function computeFit() {
        if (!draw.base) return;
        const bw = draw.base.width;
        const bh = draw.base.height;
        const availW = Math.max(120, drawHolder.clientWidth || 0);
        const availH = Math.max(120, drawHolder.clientHeight || 0);
        const k = Math.min(availW / bw, availH / bh);
        draw.dispW = Math.max(40, Math.round(bw * k));
        draw.dispH = Math.max(40, Math.round(bh * k));
        draw.z = draw.dispW / bw;
      }

      function sizeSurfaces() {
        drawInner.style.width = `${draw.dispW}px`;
        drawInner.style.height = `${draw.dispH}px`;
        drawBase.width = draw.dispW;
        drawBase.height = draw.dispH;
        paintBase();
        if (draw.canvas) {
          draw.canvas.setDimensions({ width: draw.dispW, height: draw.dispH });
          draw.canvas.calcOffset();
          draw.canvas.requestRenderAll();
        }
      }

      // 窗口尺寸变了：对象按同比例跟着缩放，位置关系不变
      function rescaleObjects(k: number) {
        if (!draw.canvas || k === 1) return;
        for (const o of draw.canvas.getObjects()) {
          o.set({
            left: (o.left || 0) * k,
            top: (o.top || 0) * k,
            scaleX: (o.scaleX || 1) * k,
            scaleY: (o.scaleY || 1) * k,
          });
          o.setCoords();
        }
      }

      function floodFillTo(cv: HTMLCanvasElement, sx: number, sy: number, hex: string) {
        const W = cv.width;
        const H = cv.height;
        if (sx < 0 || sy < 0 || sx >= W || sy >= H) return;
        const ctx = cv.getContext("2d") as CanvasRenderingContext2D;
        const img = ctx.getImageData(0, 0, W, H);
        const data = img.data;
        const start = (sy * W + sx) * 4;
        const tr = data[start];
        const tg = data[start + 1];
        const tb = data[start + 2];
        const ta = data[start + 3];
        const { r, g, b } = hexToRgb(hex);
        const tol = 44;
        const seen = new Uint8Array(W * H);
        const stack = new Int32Array(W * H);
        let sp = 0;
        const push = (i: number) => {
          if (!seen[i]) {
            seen[i] = 1;
            stack[sp++] = i;
          }
        };
        push(sy * W + sx);
        while (sp > 0) {
          const i = stack[--sp];
          const p = i * 4;
          if (
            Math.abs(data[p] - tr) > tol ||
            Math.abs(data[p + 1] - tg) > tol ||
            Math.abs(data[p + 2] - tb) > tol ||
            Math.abs(data[p + 3] - ta) > tol
          ) {
            continue;
          }
          data[p] = r;
          data[p + 1] = g;
          data[p + 2] = b;
          data[p + 3] = 255;
          const x = i % W;
          const y = (i - x) / W;
          if (x > 0) push(i - 1);
          if (x < W - 1) push(i + 1);
          if (y > 0) push(i - W);
          if (y < H - 1) push(i + W);
        }
        ctx.putImageData(img, 0, 0);
      }

      function fillAt(dx: number, dy: number) {
        if (!draw.base) return;
        const x = Math.round(dx / draw.z);
        const y = Math.round(dy / draw.z);
        pushUndo();
        const nb = copyCanvas(draw.base);
        floodFillTo(nb, x, y, pen.c1);
        draw.base = nb;
        paintBase();
        statusEl.textContent = "已填色，可以撤销";
      }

      // ── 快照 / 撤销 ──────────────────────────────────

      function snapshot(): DrawSnap {
        return {
          json: JSON.stringify(draw.canvas ? draw.canvas.toObject() : { objects: [] }),
          bg: draw.base as HTMLCanvasElement,
        };
      }

      function pushUndo() {
        if (!draw.active || !draw.canvas) return;
        draw.undo.push(snapshot());
        if (draw.undo.length > 30) draw.undo.shift();
        draw.redo = [];
        draw.pending = null;
        syncDrawUI();
      }

      async function loadJson(json: string) {
        const f = draw.canvas;
        if (!f) return;
        await f.loadFromJSON(JSON.parse(json));
        f.discardActiveObject();
        f.requestRenderAll();
      }

      async function applySnap(s: DrawSnap) {
        if (s.bg && s.bg !== draw.base) {
          draw.base = s.bg;
          paintBase();
        }
        await loadJson(s.json);
        syncDrawUI();
      }

      async function doUndo() {
        const s = draw.undo.pop();
        if (!s) return;
        draw.redo.push(snapshot());
        await applySnap(s);
      }

      async function doRedo() {
        const s = draw.redo.pop();
        if (!s) return;
        draw.undo.push(snapshot());
        await applySnap(s);
      }

      // ── 画布初始化与工具切换 ─────────────────────────

      function applyToolMode() {
        const f = draw.canvas;
        if (!f) return;
        f.isDrawingMode = pen.tool === "pen";
        f.selection = pen.tool === "select";
        f.skipTargetFind = pen.tool === "bucket";
        if (f.isDrawingMode) {
          if (!f.freeDrawingBrush) f.freeDrawingBrush = new PencilBrush(f);
          f.freeDrawingBrush.color = pen.c1;
          f.freeDrawingBrush.width = Math.max(1, pen.brush);
        }
        if (pen.tool !== "select") f.discardActiveObject();
        f.requestRenderAll();
      }

      function onCanvasDown(opt: any) {
        if (!draw.active) return;
        const f = draw.canvas;
        if (!f) return;
        if (f.isDrawingMode) {
          pushUndo();
          return;
        }
        const raw = opt.scenePoint || f.getScenePoint(opt.e);
        // 别让新对象落到画布外面去
        const pad = Math.max(30, baseSize() * 0.6);
        const p = {
          x: Math.min(Math.max(raw.x, pad), Math.max(pad, draw.dispW - pad)),
          y: Math.min(Math.max(raw.y, pad), Math.max(pad, draw.dispH - pad)),
        };
        if (pen.tool === "bucket") {
          fillAt(p.x, p.y);
          return;
        }
        if (opt.target) {
          // 拖动/缩放之前先记一版，松手时才知道该回到哪
          draw.pending = snapshot();
          return;
        }
        // 放下就取消选中：免得紧接着点色板把刚放的这个改掉
        if (pen.tool === "text") {
          pushUndo();
          keepInside(newText(p.x, p.y));
          f.discardActiveObject();
          f.requestRenderAll();
          syncDrawUI();
          return;
        }
        if (pen.tool === "shape") {
          pushUndo();
          keepInside(newShape(pen.shape, p.x, p.y));
          f.discardActiveObject();
          f.requestRenderAll();
          syncDrawUI();
        }
      }

      function initCanvas() {
        const f = new Canvas(drawCanvasEl, {
          preserveObjectStacking: true,
          selection: true,
          uniformScaling: false,
          backgroundColor: "transparent",
        });
        draw.canvas = f;

        f.on("mouse:down", onCanvasDown);
        f.on("selection:created", syncDrawUI);
        f.on("selection:updated", syncDrawUI);
        f.on("selection:cleared", syncDrawUI);
        f.on("object:modified", () => {
          if (draw.pending) {
            draw.undo.push(draw.pending);
            if (draw.undo.length > 30) draw.undo.shift();
            draw.redo = [];
            draw.pending = null;
            syncDrawUI();
          }
        });
        f.on("path:created", (e: any) => {
          const path = e.path;
          if (path) {
            if (pen.mode === "gradient") {
              path.set({ stroke: makeGradient(path.width || 60, path.height || 60) });
            }
            path.set({ dirty: true });
          }
          draw.pending = null;
          f.requestRenderAll();
          syncDrawUI();
        });
      }

      // ── 面板状态同步 ─────────────────────────────────

      function selLabel(o: any) {
        if (!o) return "";
        if (isTextObj(o)) return "文字";
        if (o.type === "line") return "直线";
        if (o.type === "path") return "笔迹";
        if (o.type === "polygon") return "多边形";
        if (o.type === "circle") return "圆形";
        if (o.type === "triangle") return "三角形";
        if (o.type === "rect") return "矩形";
        return "对象";
      }

      function syncDrawUI() {
        if (!drawPage) return;
        for (const b of drawPage.querySelectorAll<HTMLElement>("[data-tool]")) {
          b.setAttribute("aria-pressed", String(b.dataset.tool === pen.tool));
        }
        for (const g of drawPage.querySelectorAll<HTMLElement>("[data-show]")) {
          g.hidden = g.dataset.show !== pen.tool;
        }
        for (const b of drawPage.querySelectorAll<HTMLElement>("[data-mode]")) {
          b.setAttribute("aria-pressed", String(b.dataset.mode === pen.mode));
        }
        for (const g of drawPage.querySelectorAll<HTMLElement>("[data-when]")) {
          g.hidden = pen.mode !== "gradient";
        }
        for (const b of drawPage.querySelectorAll<HTMLElement>("[data-shape]")) {
          b.setAttribute("aria-pressed", String(b.dataset.shape === pen.shape));
        }
        for (const b of drawPage.querySelectorAll<HTMLElement>("[data-gtype]")) {
          b.setAttribute("aria-pressed", String(b.dataset.gtype === pen.gtype));
        }

        const sizeVal = drawPage.querySelector<HTMLElement>('[data-val="size"]');
        if (sizeVal) sizeVal.textContent = `${pen.sizePct}% · ${textSize()}px`;
        const brushVal = drawPage.querySelector<HTMLElement>('[data-val="brush"]');
        if (brushVal) brushVal.textContent = `${pen.brush}px`;
        const angleVal = drawPage.querySelector<HTMLElement>('[data-val="angle"]');
        if (angleVal) angleVal.textContent = `${pen.angle}°`;

        drawPage
          .querySelector('[data-draw-act="bold"]')
          ?.setAttribute("aria-pressed", String(pen.bold));
        drawPage
          .querySelector('[data-draw-act="italic"]')
          ?.setAttribute("aria-pressed", String(pen.italic));

        const sel = selectedObject();
        if (
          sel &&
          isTextObj(sel) &&
          drawTextInput &&
          document.activeElement !== drawTextInput
        ) {
          drawTextInput.value = String(sel.text || "");
        }
        const selBox = drawPage.querySelector<HTMLElement>('[data-role="sel-box"]');
        if (selBox) selBox.hidden = !sel;
        const selVal = drawPage.querySelector<HTMLElement>('[data-val="sel"]');
        if (selVal) selVal.textContent = selLabel(sel);

        for (const [act, list] of [
          ["undo", draw.undo],
          ["redo", draw.redo],
        ] as const) {
          for (const b of document.querySelectorAll<HTMLButtonElement>(
            `[data-draw-act="${act}"]`,
          )) {
            b.disabled = list.length === 0;
          }
        }

        if (drawHintEl) {
          drawHintEl.textContent = !draw.active
            ? ""
            : pen.tool === "text"
              ? "点画布加文字 · 选中后在这里改内容"
              : pen.tool === "shape"
                ? "点画布放形状 · 拖四角缩放 · 拖上方圆点旋转"
                : pen.tool === "pen"
                  ? "按住直接画，松手后整笔可拖动"
                  : pen.tool === "bucket"
                    ? "点一下要填色的区域"
                    : "点选对象后可拖动 / 缩放 / 旋转，Delete 删除";
        }
      }

      // ── 会话：进入 / 退出 / 应用 ─────────────────────

      const MAX_EDIT_EDGE = 2400;

      function freshBase(item: any) {
        const bw = item.bitmap.width || item.w0;
        const bh = item.bitmap.height || item.h0;
        const k = Math.min(1, MAX_EDIT_EDGE / Math.max(bw, bh));
        const W = Math.max(1, Math.round(bw * k));
        const H = Math.max(1, Math.round(bh * k));
        const c = document.createElement("canvas");
        c.width = W;
        c.height = H;
        c.getContext("2d")!.drawImage(item.bitmap, 0, 0, W, H);
        return c;
      }

      async function flatten() {
        const f = draw.canvas;
        // 选中框是画在渲染层上的，导出前必须摘掉，否则会被烙进图片
        const active = f?.getActiveObject?.() || null;
        if (active) {
          f.discardActiveObject();
          f.renderAll();
        }
        const out = document.createElement("canvas");
        out.width = draw.W;
        out.height = draw.H;
        const ctx = out.getContext("2d")!;
        ctx.drawImage(draw.base as HTMLCanvasElement, 0, 0);
        const objs = f?.getObjects?.() || [];
        if (objs.length) {
          const layer = f.toCanvasElement(1 / draw.z);
          ctx.drawImage(layer, 0, 0, draw.W, draw.H);
        }
        if (active && draw.canvas) {
          draw.canvas.setActiveObject(active);
          draw.canvas.requestRenderAll();
        }
        return out;
      }

      async function startDraw(item: any) {
        if (!item) return;
        if (draw.active && draw.item === item) {
          switchTab("draw");
          return;
        }
        if (draw.active) await endDraw(false);

        draw.active = true;
        draw.item = item;
        draw.base = freshBase(item);
        draw.W = draw.base.width;
        draw.H = draw.base.height;
        draw.undo = [];
        draw.redo = [];
        draw.pending = null;

        drawHolder.hidden = false;
        previewEl!.hidden = true;
        stageOpsEl.hidden = false;
        drawHintEl.hidden = false;
        btnDrawOne.hidden = true;
        btnCropOne.hidden = true;
        btnSaveOne.hidden = true;
        tabBar?.querySelector('[data-tab="draw"]')?.classList.add("has-session");

        if (!draw.canvas) initCanvas();
        computeFit();
        sizeSurfaces();
        if (draw.canvas) {
          draw.canvas.remove(...draw.canvas.getObjects());
          draw.canvas.discardActiveObject();
          draw.canvas.requestRenderAll();
        }
        applyToolMode();
        switchTab("draw");
        syncDrawUI();
      }

      async function endDraw(commit: boolean) {
        if (!draw.active) return;
        const item = draw.item;

        if (commit && item) {
          try {
            const out = await flatten();
            const blob = await new Promise<Blob | null>((r) =>
              out.toBlob(r, "image/png"),
            );
            if (blob) {
              const bmp = await createImageBitmap(blob);
              item.bitmap.close?.();
              item.bitmap = bmp;
              item.w0 = bmp.width;
              item.h0 = bmp.height;
              item.drawn = true;
              delete item.crop;
              statusEl.textContent = "编辑已写回这张图";
            }
          } catch (err) {
            console.warn("[image-tool] 应用失败", err);
            statusEl.textContent = "应用失败，已保留原图";
          }
        }

        draw.active = false;
        draw.item = null;
        draw.base = null;
        draw.undo = [];
        draw.redo = [];
        draw.pending = null;
        draw.W = 0;
        draw.H = 0;

        if (draw.canvas) {
          draw.canvas.remove(...draw.canvas.getObjects());
          draw.canvas.discardActiveObject();
          draw.canvas.isDrawingMode = false;
          draw.canvas.requestRenderAll();
        }
        drawHolder.hidden = true;
        previewEl!.hidden = false;
        stageOpsEl.hidden = true;
        drawHintEl.hidden = true;
        btnDrawOne.hidden = false;
        btnCropOne.hidden = false;
        btnSaveOne.hidden = false;
        tabBar?.querySelector('[data-tab="draw"]')?.classList.remove("has-session");

        scheduleRedraw();
        syncPanel();
        syncDrawUI();

        // 应用后接着开一段新的编辑，方便连续加东西；取消则回到尺寸页
        if (commit && item) startDraw(item);
        else if (!commit && state.items.length) switchTab("size");
      }

      function resetCanvas() {
        if (!draw.active || !draw.item) return;
        pushUndo();
        draw.base = freshBase(draw.item);
        paintBase();
        if (draw.canvas) {
          draw.canvas.remove(...draw.canvas.getObjects());
          draw.canvas.discardActiveObject();
          draw.canvas.requestRenderAll();
        }
        statusEl.textContent = "已还原到原图";
        syncDrawUI();
      }

      function deleteSelected() {
        const sel = selectedObject();
        if (!sel || !draw.canvas) return;
        pushUndo();
        draw.canvas.remove(sel);
        draw.canvas.discardActiveObject();
        draw.canvas.requestRenderAll();
        syncDrawUI();
      }

      // ── 面板交互 ────────────────────────────────────

      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-draw-act]");
        const act = el?.dataset.drawAct;
        if (!act) return;

        if (act === "apply") {
          endDraw(true);
          return;
        }
        if (act === "cancel") {
          endDraw(false);
          return;
        }
        if (!draw.active) return;

        if (act === "undo") {
          doUndo();
          return;
        }
        if (act === "redo") {
          doRedo();
          return;
        }
        if (act === "reset") {
          resetCanvas();
          return;
        }
        if (act === "clear") {
          resetCanvas();
          return;
        }
        if (act === "delete") {
          deleteSelected();
          return;
        }
        if (act === "dup") {
          const sel = selectedObject();
          if (!sel || !draw.canvas) return;
          pushUndo();
          sel.clone().then((c: any) => {
            c.set({ left: (sel.left || 0) + 18, top: (sel.top || 0) + 18 });
            c.setCoords();
            draw.canvas.add(c);
            draw.canvas.setActiveObject(c);
            draw.canvas.requestRenderAll();
            syncDrawUI();
          });
          return;
        }
        if (act === "front" || act === "back") {
          const sel = selectedObject();
          if (!sel || !draw.canvas) return;
          pushUndo();
          if (act === "front") draw.canvas.bringObjectForward(sel);
          else draw.canvas.sendObjectBackwards(sel);
          draw.canvas.requestRenderAll();
          return;
        }
        if (act === "bold" || act === "italic") {
          if (act === "bold") pen.bold = !pen.bold;
          else pen.italic = !pen.italic;
          const sel = selectedObject();
          if (sel && isTextObj(sel)) {
            pushUndo();
            applyStyle(sel);
            draw.canvas.requestRenderAll();
          }
          syncDrawUI();
          return;
        }
      });

      drawPage?.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;

        const tool = t.closest<HTMLElement>("[data-tool]")?.dataset.tool;
        if (tool && ["select", "text", "shape", "pen", "bucket"].includes(tool)) {
          pen.tool = tool as typeof pen.tool;
          if (pen.tool !== "pen" && draw.canvas) draw.canvas.isDrawingMode = false;
          applyToolMode();
          syncDrawUI();
          return;
        }

        const mode = t.closest<HTMLElement>("[data-mode]")?.dataset.mode;
        if (mode === "solid" || mode === "gradient") {
          pen.mode = mode;
          const sel = selectedObject();
          if (sel) {
            pushUndo();
            applyStyle(sel);
            draw.canvas.requestRenderAll();
          }
          syncDrawUI();
          return;
        }

        const shape = t.closest<HTMLElement>("[data-shape]")?.dataset.shape;
        if (shape) {
          pen.shape = shape;
          syncDrawUI();
          return;
        }

        const gt = t.closest<HTMLElement>("[data-gtype]")?.dataset.gtype;
        if (gt === "linear" || gt === "radial") {
          pen.gtype = gt;
          const sel = selectedObject();
          if (sel) {
            pushUndo();
            applyStyle(sel);
            draw.canvas.requestRenderAll();
          }
          syncDrawUI();
          return;
        }

        const gp = t.closest<HTMLElement>("[data-gpreset]")?.dataset.gpreset;
        if (gp !== undefined) {
          const g = GRADIENT_PRESETS[Number(gp)];
          if (g) {
            pen.c1 = g.c1;
            pen.c2 = g.c2;
            pen.angle = g.angle;
            for (const [key, val] of [
              ["c1", g.c1],
              ["c2", g.c2],
            ]) {
              const inp = drawPage?.querySelector<HTMLInputElement>(
                `[data-color="${key}"]`,
              );
              if (inp) inp.value = val;
            }
            const ang = drawPage?.querySelector<HTMLInputElement>(
              '[data-role="angle"]',
            );
            if (ang) ang.value = String(g.angle);
            const sel = selectedObject();
            if (sel) {
              pushUndo();
              applyStyle(sel);
              draw.canvas.requestRenderAll();
            }
            syncDrawUI();
          }
          return;
        }

        const sw = t.closest<HTMLElement>("[data-swatch]")?.dataset.swatch;
        if (sw) {
          pen.c1 = sw;
          const c1 = drawPage?.querySelector<HTMLInputElement>('[data-color="c1"]');
          if (c1) c1.value = sw;
          const sel = selectedObject();
          if (sel) {
            pushUndo();
            applyStyle(sel);
            draw.canvas.requestRenderAll();
          }
          svgHintIfDrawing();
          return;
        }
      });

      function svgHintIfDrawing() {
        const f = draw.canvas;
        if (f?.freeDrawingBrush) f.freeDrawingBrush.color = pen.c1;
      }

      drawTextInput?.addEventListener("input", () => {
        pen.text = drawTextInput.value;
        const sel = selectedObject();
        if (sel && isTextObj(sel)) {
          sel.set({ text: drawTextInput.value || " " });
          sel.setCoords();
          draw.canvas?.requestRenderAll();
        }
      });

      drawPage
        ?.querySelector<HTMLInputElement>('[data-role="size"]')
        ?.addEventListener("input", (e) => {
          pen.sizePct = Number((e.target as HTMLInputElement).value);
          const sel = selectedObject();
          if (sel && isTextObj(sel)) {
            sel.set({ fontSize: textSize() });
            sel.setCoords();
            draw.canvas.requestRenderAll();
          }
          syncDrawUI();
        });

      drawPage
        ?.querySelector<HTMLInputElement>('[data-role="brush"]')
        ?.addEventListener("input", (e) => {
          pen.brush = Number((e.target as HTMLInputElement).value);
          if (draw.canvas?.freeDrawingBrush) {
            draw.canvas.freeDrawingBrush.width = Math.max(1, pen.brush);
          }
          syncDrawUI();
        });

      drawPage
        ?.querySelector<HTMLInputElement>('[data-role="angle"]')
        ?.addEventListener("input", (e) => {
          pen.angle = Number((e.target as HTMLInputElement).value);
          const sel = selectedObject();
          if (sel) {
            applyStyle(sel);
            draw.canvas.requestRenderAll();
          }
          syncDrawUI();
        });

      for (const el of drawPage?.querySelectorAll<HTMLInputElement>("[data-color]") || []) {
        el.addEventListener("input", () => {
          if (el.dataset.color === "c1") pen.c1 = el.value;
          else pen.c2 = el.value;
          const sel = selectedObject();
          if (sel) {
            applyStyle(sel);
            draw.canvas.requestRenderAll();
          }
          svgHintIfDrawing();
        });
      }

      // 快捷键：撤销 / 重做（Delete 交给 Fabric 自己处理）
      document.addEventListener("keydown", (e) => {
        if (!draw.active) return;
        const tag = (e.target as HTMLElement)?.tagName;
        const typing =
          tag === "INPUT" || tag === "TEXTAREA" || (e.target as HTMLElement)?.isContentEditable;
        if (typing) return;
        const mod = e.metaKey || e.ctrlKey;
        if (mod && e.key.toLowerCase() === "z") {
          e.preventDefault();
          if (e.shiftKey) doRedo();
          else doUndo();
          return;
        }
        if (mod && e.key.toLowerCase() === "y") {
          e.preventDefault();
          doRedo();
        }
      });

      // 窗口尺寸变化时重新贴合，别让画布溢出舞台
      let resizeTimer = 0;
      window.addEventListener("resize", () => {
        if (!draw.active) return;
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          if (!draw.active || !draw.base) return;
          const oldW = draw.dispW;
          computeFit();
          rescaleObjects(draw.dispW / Math.max(1, oldW));
          sizeSurfaces();
        }, 160);
      });

      btnDrawOne.addEventListener("click", () => {
        const item = activeItem();
        if (item) startDraw(item);
      });

      // ── 初始化 ────────────────────────────────────────

      syncLayout();
      syncPanel();
      syncActions();
    </script>

    <script>
      // ── 深浅色切换 ────────────────────────────────────
      const SUN = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-1-11V2h2v2h-2Zm0 18v-2h2v2h-2ZM4 13H2v-2h2v2Zm18 0h-2v-2h2v2ZM5.6 7 4.2 5.6 5.6 4.2 7 5.6 5.6 7Zm12.8 12.8-1.4-1.4 1.4-1.4 1.4 1.4-1.4 1.4ZM5.6 17l1.4 1.4-1.4 1.4L4.2 18.4 5.6 17ZM18.4 7l-1.4-1.4 1.4-1.4 1.4 1.4L18.4 7Z"/></svg>`;
      const MOON = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21q-3.75 0-6.375-2.625T3 12q0-3.75 2.625-6.375T12 3q.35 0 .688.025.337.025.662.075-.5.725-.762 1.55Q12.3 5.475 12.3 6.35q0 2.35 1.675 4.025Q15.65 12.05 18 12.05q.875 0 1.7-.263.825-.262 1.55-.762.05.325.075.663.075.337.075.712 0 3.75-2.625 6.375T12 21Z"/></svg>`;

      const themeBtn = document.getElementById("tool-theme");
      const themeIcon = themeBtn?.querySelector<HTMLElement>(".tool-theme-icon");

      function syncThemeIcon() {
        if (!themeIcon) return;
        const dark = document.documentElement.dataset.theme === "dark";
        themeIcon.innerHTML = dark ? SUN : MOON;
      }

      themeBtn?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("tool-theme", next);
        } catch {
          // 隐私模式下存不了，忽略即可
        }
        syncThemeIcon();
      });

      syncThemeIcon();
    </script>
  </body>
</html>
