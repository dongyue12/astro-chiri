---
import "@/styles/pages/rank-standalone.css";
import "@/styles/pages/image-tool.css";

const title = "图片处理";
const description =
	"在线做图片格式转换、缩放、裁剪、圆角、旋转翻转与亮度调整，逐张编辑、批量导出。全部在浏览器本地完成，图片不会上传。";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title} · 工具箱</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body>
    <header class="tool-topbar">
      <a class="tool-back" href="/tools/">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8h5Z"></path>
        </svg>
        工具箱
      </a>
      <h1 class="tool-title">{title}</h1>
      <span class="tool-chip">图片不上传</span>
    </header>

    <main class="tool-main">
      <div class="img-app">
        <!-- 左：预览 + 缩略图 -->
        <section class="img-main">
          <div class="img-drop" id="img-drop" role="button" tabindex="0">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M19 13v6H5v-6H3v6q0 .825.588 1.413Q4.175 21 5 21h14q.825 0 1.413-.587Q21 19.825 21 19v-6h-2ZM12 3 7 8l1.4 1.45 2.6-2.6V16h2V6.85l2.6 2.6L17 8l-5-5Z"
              ></path>
            </svg>
            <strong>点击选择图片，或直接拖进来</strong>
            <span>支持 PNG / JPEG / WebP / GIF / AVIF，可一次多选</span>
            <small>所有处理都在你的浏览器里完成，不会上传到服务器</small>
          </div>
          <input id="img-input" type="file" accept="image/*" multiple hidden />

          <!-- 主预览：当前正在编辑的那张 -->
          <div class="img-stage" id="img-stage" hidden>
            <div class="img-stage-bar">
              <span class="stage-name" id="stage-name"></span>
              <span class="stage-meta" id="stage-meta"></span>
              <button class="stage-btn" type="button" id="btn-crop-one">裁剪</button>
              <button class="stage-btn" type="button" id="btn-save-one">
                下载这张
              </button>
            </div>
            <canvas class="img-preview" id="img-preview"></canvas>
          </div>

          <!-- 缩略图条：其余图片都在这里 -->
          <div class="img-strip" id="img-strip" hidden></div>
        </section>

        <!-- 右：设置面板（作用于当前这张）-->
        <aside class="img-panel" id="img-panel" data-empty="1">
          <div class="panel-scroll">
          <div class="panel-section">
            <div class="panel-title">
              <span>输出格式</span>
              <span class="panel-val" id="val-format">原格式</span>
            </div>
            <div class="seg" id="seg-format">
              <button type="button" data-format="original" aria-pressed="true">
                原格式
              </button>
              <button type="button" data-format="webp" aria-pressed="false">
                WebP
              </button>
              <button type="button" data-format="jpeg" aria-pressed="false">
                JPEG
              </button>
              <button type="button" data-format="png" aria-pressed="false">
                PNG
              </button>
            </div>
          </div>

          <div class="panel-section" id="quality-section">
            <div class="panel-title">
              <span>质量</span>
              <span class="panel-val" id="val-quality">85%</span>
            </div>
            <div class="slider-row">
              <input
                type="range"
                id="in-quality"
                min="10"
                max="100"
                step="1"
                value="85"
                aria-label="输出质量"
              />
            </div>
            <div class="panel-note" id="quality-note">
              数值越低体积越小，PNG 为无损
            </div>
          </div>

          <div class="panel-section">
            <div class="panel-title">
              <span>输出宽度</span>
              <span class="panel-val" id="val-width">原始</span>
            </div>
            <div class="num-row">
              <input
                type="number"
                id="in-width"
                min="1"
                step="1"
                placeholder="留空 = 原始宽度"
              />
              <span class="num-suffix">px</span>
            </div>
            <div class="panel-note">高度按原比例自动计算，旋转后自动互换</div>
          </div>

          <div class="panel-section">
            <div class="panel-title">
              <span>裁剪比例</span>
              <span class="panel-val" id="val-crop">原比例</span>
            </div>
            <div class="seg seg-wrap" id="seg-crop">
              <button type="button" data-ratio="original" aria-pressed="true">
                原比例
              </button>
              <button type="button" data-ratio="1:1" aria-pressed="false">1:1</button>
              <button type="button" data-ratio="4:3" aria-pressed="false">4:3</button>
              <button type="button" data-ratio="3:4" aria-pressed="false">3:4</button>
              <button type="button" data-ratio="16:9" aria-pressed="false">16:9</button>
              <button type="button" data-ratio="9:16" aria-pressed="false">9:16</button>
            </div>
            <div class="panel-note">
              自动从中心裁切；要手动框选点上方「裁剪」按钮，手动裁剪优先
            </div>
          </div>

          <div class="panel-section">
            <div class="panel-title"><span>旋转与翻转</span></div>
            <div class="btn-group">
              <button class="icon-btn" type="button" id="btn-rot-l">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M7.1 16.9q-2-2-2-4.9t2-4.9Q9.1 5 12 5h.2L9.6 2.4 11 1l4.9 5L11 11l-1.4-1.4L12.2 7H12q-2 0-3.5 1.5T7 12q0 2 1.5 3.5T12 17v2q-2.9 0-4.9-2.1Z"></path>
                </svg>
                左转
              </button>
              <button class="icon-btn" type="button" id="btn-rot-r">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M16.9 16.9q2-2 2-4.9t-2-4.9Q14.9 5 12 5h-.2l2.6-2.6L13 1 8.1 6l4.9 5 1.4-1.4L11.8 7h.2q2 0 3.5 1.5T17 12q0 2-1.5 3.5T12 17v2q2.9 0 4.9-2.1Z"></path>
                </svg>
                右转
              </button>
            </div>
            <div class="btn-group">
              <button class="icon-btn" type="button" id="btn-flip-h" aria-pressed="false">
                水平翻转
              </button>
              <button class="icon-btn" type="button" id="btn-flip-v" aria-pressed="false">
                垂直翻转
              </button>
            </div>
          </div>

          <div class="panel-section">
            <div class="panel-title">
              <span>亮度</span>
              <span class="panel-val" id="val-bright">100%</span>
            </div>
            <div class="slider-row">
              <input type="range" id="in-bright" min="20" max="200" value="100" aria-label="亮度" />
            </div>
          </div>

          <div class="panel-section">
            <div class="panel-title">
              <span>对比度</span>
              <span class="panel-val" id="val-contrast">100%</span>
            </div>
            <div class="slider-row">
              <input type="range" id="in-contrast" min="20" max="200" value="100" aria-label="对比度" />
            </div>
          </div>

          <div class="panel-section">
            <div class="panel-title">
              <span>饱和度</span>
              <span class="panel-val" id="val-saturate">100%</span>
            </div>
            <div class="slider-row">
              <input type="range" id="in-saturate" min="0" max="200" value="100" aria-label="饱和度" />
            </div>
          </div>

          <div class="panel-section">
            <div class="panel-title">
              <span>圆角</span>
              <span class="panel-val" id="val-radius">0%</span>
            </div>
            <div class="slider-row">
              <input type="range" id="in-radius" min="0" max="50" value="0" aria-label="圆角半径" />
            </div>
            <div class="panel-note">
              按短边百分比计算，50% 为完全圆角；要透明边角请导出 PNG / WebP
            </div>
          </div>

          </div>

          <div class="panel-actions">
            <button class="act-btn act-btn-primary" type="button" id="btn-export-edited" disabled>
              下载修改的
            </button>
            <div class="act-row">
              <button class="act-btn act-btn-ghost" type="button" id="btn-export-all" disabled>
                全部下载
              </button>
              <button class="act-btn act-btn-ghost" type="button" id="btn-reset">
                重置这张
              </button>
            </div>
            <button class="act-btn act-btn-ghost" type="button" id="btn-apply-all">
              把当前设置应用到全部
            </button>
            <div class="panel-status" id="status">还没有添加图片</div>
          </div>
        </aside>
      </div>
    </main>

    <script>
      const ICON_X = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.4 19 5 17.6 10.6 12 5 6.4 6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19Z"/></svg>`;

      const EXT = {
        "image/png": "png",
        "image/jpeg": "jpg",
        "image/webp": "webp",
        "image/gif": "gif",
        "image/avif": "avif",
      };

      const FORMAT_LABEL = {
        original: "原格式",
        webp: "WebP",
        jpeg: "JPEG",
        png: "PNG",
      };

      // 裁剪比例：null 表示不裁
      const RATIOS = {
        original: null,
        "1:1": 1,
        "4:3": 4 / 3,
        "3:4": 3 / 4,
        "16:9": 16 / 9,
        "9:16": 9 / 16,
      };

      const RATIO_LABEL = {
        original: "原比例",
        "1:1": "1:1",
        "4:3": "4:3",
        "3:4": "3:4",
        "16:9": "16:9",
        "9:16": "9:16",
      };

      // 每张图各自的编辑参数
      const EDIT_DEFAULTS = {
        format: "original",
        quality: 85,
        width: null,
        rotate: 0,
        flipH: false,
        flipV: false,
        brightness: 100,
        contrast: 100,
        saturate: 100,
        cropRatio: "original",
        radius: 0,
      };

      const state = { items: [], seq: 0, activeId: null };

      const drop = document.getElementById("img-drop");
      const input = document.getElementById("img-input");
      const stripEl = document.getElementById("img-strip");
      const stageEl = document.getElementById("img-stage");
      const previewEl = document.getElementById("img-preview");
      const panelEl = document.getElementById("img-panel");
      const statusEl = document.getElementById("status");
      const btnExportEdited = document.getElementById("btn-export-edited");
      const btnExportAll = document.getElementById("btn-export-all");

      const itemOf = (id) => state.items.find((i) => i.id === id) || null;
      const activeItem = () => itemOf(state.activeId);

      // ── 尺寸与绘制 ────────────────────────────────────

      // 某张图在“原始像素坐标系”下要取的区域
      function cropRect(item) {
        const w0 = item.w0;
        const h0 = item.h0;
        // 手动裁剪（归一化坐标）优先于全局比例
        if (item.crop) {
          return {
            x: item.crop.x * w0,
            y: item.crop.y * h0,
            w: Math.max(1, item.crop.w * w0),
            h: Math.max(1, item.crop.h * h0),
          };
        }
        const r = RATIOS[item.edit.cropRatio];
        if (!r) return { x: 0, y: 0, w: w0, h: h0 };
        const cur = w0 / h0;
        let cw;
        let ch;
        if (cur > r) {
          ch = h0;
          cw = h0 * r;
        } else {
          cw = w0;
          ch = w0 / r;
        }
        return { x: (w0 - cw) / 2, y: (h0 - ch) / 2, w: cw, h: ch };
      }

      function outSize(item) {
        const c = cropRect(item);
        const e = item.edit;
        let w = c.w;
        let h = c.h;
        if (e.width && e.width > 0) {
          const k = e.width / w;
          w = e.width;
          h = h * k;
        }
        w = Math.max(1, Math.round(w));
        h = Math.max(1, Math.round(h));
        if (e.rotate % 180 !== 0) {
          const t = w;
          w = h;
          h = t;
        }
        return { w, h };
      }

      function roundRectPath(ctx, x, y, w, h, r) {
        const rr = Math.min(r, w / 2, h / 2);
        ctx.moveTo(x + rr, y);
        ctx.lineTo(x + w - rr, y);
        ctx.arcTo(x + w, y, x + w, y + rr, rr);
        ctx.lineTo(x + w, y + h - rr);
        ctx.arcTo(x + w, y + h, x + w - rr, y + h, rr);
        ctx.lineTo(x + rr, y + h);
        ctx.arcTo(x, y + h, x, y + h - rr, rr);
        ctx.lineTo(x, y + rr);
        ctx.arcTo(x, y, x + rr, y, rr);
        ctx.closePath();
      }

      function drawItem(canvas, item, maxEdge) {
        const e = item.edit;
        const { w, h } = outSize(item);
        const s = maxEdge ? Math.min(1, maxEdge / Math.max(w, h)) : 1;
        const cw = Math.max(1, Math.round(w * s));
        const ch = Math.max(1, Math.round(h * s));
        canvas.width = cw;
        canvas.height = ch;
        const ctx = canvas.getContext("2d");
        ctx.clearRect(0, 0, cw, ch);

        // 圆角：先裁剪路径，再画内容
        const radius = e.radius > 0 ? (Math.min(cw, ch) * e.radius) / 100 : 0;
        if (radius > 0) {
          ctx.beginPath();
          if (typeof ctx.roundRect === "function") {
            ctx.roundRect(0, 0, cw, ch, radius);
          } else {
            roundRectPath(ctx, 0, 0, cw, ch, radius);
          }
          ctx.clip();
        }

        const rotated = e.rotate % 180 !== 0;
        const bw = rotated ? ch : cw;
        const bh = rotated ? cw : ch;
        const src = cropRect(item);

        ctx.save();
        ctx.filter = `brightness(${e.brightness}%) contrast(${e.contrast}%) saturate(${e.saturate}%)`;
        ctx.translate(cw / 2, ch / 2);
        ctx.rotate((e.rotate * Math.PI) / 180);
        ctx.scale(e.flipH ? -1 : 1, e.flipV ? -1 : 1);
        ctx.drawImage(item.bitmap, src.x, src.y, src.w, src.h, -bw / 2, -bh / 2, bw, bh);
        ctx.restore();
      }

      function mimeOf(item) {
        const f = item.edit.format;
        if (f === "original") {
          if (item.mime === "image/png" || item.mime === "image/webp") {
            return item.mime;
          }
          return "image/jpeg";
        }
        return "image/" + f;
      }

      // ── 状态判断 ──────────────────────────────────────

      function isEdited(item) {
        if (item.crop) return true;
        for (const k in EDIT_DEFAULTS) {
          if (item.edit[k] !== EDIT_DEFAULTS[k]) return true;
        }
        return false;
      }

      // ── 界面刷新 ──────────────────────────────────────

      function syncStripState() {
        for (const el of stripEl.querySelectorAll(".img-thumb")) {
          const it = itemOf(el.dataset.id);
          el.classList.toggle("is-active", el.dataset.id === state.activeId);
          el.classList.toggle("is-edited", it ? isEdited(it) : false);
        }
      }

      function syncActions() {
        const total = state.items.length;
        const edited = state.items.filter(isEdited).length;
        btnExportEdited.disabled = edited === 0;
        btnExportAll.disabled = total === 0;
        btnExportEdited.textContent = edited
          ? `下载修改的 (${edited})`
          : "下载修改的";
        if (total) {
          statusEl.textContent = `共 ${total} 张，已修改 ${edited} 张`;
        } else {
          statusEl.textContent = "还没有添加图片";
        }
      }

      function drawPreview() {
        const item = activeItem();
        if (!item) return;
        drawItem(previewEl, item, 1400);
        const o = outSize(item);
        const ext = EXT[mimeOf(item)] || "png";
        document.getElementById("stage-name").textContent = item.name;
        document.getElementById("stage-meta").textContent =
          `${item.w0}×${item.h0} → ${o.w}×${o.h} · ${ext}`;
      }

      function drawThumbs() {
        for (const item of state.items) {
          if (item.thumb) drawItem(item.thumb, item, 160);
        }
      }

      function syncLayout() {
        const has = state.items.length > 0;
        stageEl.hidden = !has;
        stripEl.hidden = !has;
        drop.hidden = has;
        panelEl.dataset.empty = has ? "0" : "1";
      }

      let rafId = 0;
      function scheduleRedraw() {
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          drawThumbs();
          drawPreview();
          syncStripState();
          syncActions();
          syncWidthLabel();
        });
      }

      // ── 面板与当前图同步 ──────────────────────────────

      function syncWidthLabel() {
        const el = document.getElementById("val-width");
        const item = activeItem();
        if (!item || !item.edit.width) {
          el.textContent = "原始";
          return;
        }
        const o = outSize(item);
        el.textContent = `${o.w} × ${o.h}`;
      }

      function syncPanel() {
        const item = activeItem();
        const e = item ? item.edit : EDIT_DEFAULTS;

        for (const btn of document.querySelectorAll("#seg-format button")) {
          btn.setAttribute("aria-pressed", String(btn.dataset.format === e.format));
        }
        document.getElementById("val-format").textContent =
          FORMAT_LABEL[e.format] || "原格式";

        const lossy = e.format !== "png";
        const qInput = document.getElementById("in-quality");
        qInput.disabled = !lossy;
        qInput.value = String(e.quality);
        document.getElementById("val-quality").textContent = `${e.quality}%`;
        document.getElementById("quality-section").style.opacity = lossy ? "1" : "0.55";
        document.getElementById("quality-note").textContent = lossy
          ? "数值越低体积越小"
          : "PNG 为无损格式，忽略质量";

        document.getElementById("in-width").value = e.width ? String(e.width) : "";

        for (const btn of document.querySelectorAll("#seg-crop button")) {
          btn.setAttribute("aria-pressed", String(btn.dataset.ratio === e.cropRatio));
        }
        document.getElementById("val-crop").textContent =
          RATIO_LABEL[e.cropRatio] || "原比例";

        document.getElementById("btn-flip-h").setAttribute("aria-pressed", String(e.flipH));
        document.getElementById("btn-flip-v").setAttribute("aria-pressed", String(e.flipV));

        for (const [id, key, outId] of [
          ["in-bright", "brightness", "val-bright"],
          ["in-contrast", "contrast", "val-contrast"],
          ["in-saturate", "saturate", "val-saturate"],
          ["in-radius", "radius", "val-radius"],
        ]) {
          document.getElementById(id).value = String(e[key]);
          document.getElementById(outId).textContent = `${e[key]}%`;
        }

        syncWidthLabel();
      }

      function applyEdit(patch) {
        const item = activeItem();
        if (!item) return;
        Object.assign(item.edit, patch);
        scheduleRedraw();
      }

      // ── 缩略图条 ──────────────────────────────────────

      function renderStrip() {
        stripEl.innerHTML = "";
        for (const item of state.items) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "img-thumb";
          b.dataset.id = item.id;
          b.title = item.name;

          const c = document.createElement("canvas");
          b.appendChild(c);

          const del = document.createElement("span");
          del.className = "img-thumb-del";
          del.setAttribute("role", "button");
          del.setAttribute("aria-label", "移除这张");
          del.innerHTML = ICON_X;
          b.appendChild(del);

          item.thumb = c;
          stripEl.appendChild(b);
        }

        const add = document.createElement("button");
        add.type = "button";
        add.className = "img-thumb-add";
        add.title = "添加图片";
        add.setAttribute("aria-label", "添加图片");
        add.textContent = "+";
        add.addEventListener("click", () => input.click());
        stripEl.appendChild(add);

        syncStripState();
      }

      function scrollStripToActive() {
        const el = stripEl.querySelector(".img-thumb.is-active");
        if (!el) return;
        const r = el.getBoundingClientRect();
        const sr = stripEl.getBoundingClientRect();
        if (r.left < sr.left) {
          stripEl.scrollLeft -= sr.left - r.left + 10;
        } else if (r.right > sr.right) {
          stripEl.scrollLeft += r.right - sr.right + 10;
        }
      }

      function setActive(id) {
        state.activeId = id;
        syncStripState();
        syncPanel();
        drawPreview();
        scrollStripToActive();
      }

      stripEl.addEventListener("click", (e) => {
        const thumb = e.target.closest(".img-thumb");
        if (!thumb) return;
        const id = thumb.dataset.id;
        if (e.target.closest(".img-thumb-del")) {
          removeItem(id);
          return;
        }
        setActive(id);
      });

      function removeItem(id) {
        const idx = state.items.findIndex((i) => i.id === id);
        if (idx < 0) return;
        state.items[idx].bitmap.close?.();
        state.items.splice(idx, 1);
        if (state.activeId === id) {
          const next = state.items[Math.min(idx, state.items.length - 1)];
          state.activeId = next ? next.id : null;
        }
        renderStrip();
        syncLayout();
        syncPanel();
        scheduleRedraw();
      }

      // ── 载入图片 ──────────────────────────────────────

      async function decode(file) {
        try {
          return await createImageBitmap(file, { imageOrientation: "from-image" });
        } catch {
          try {
            return await createImageBitmap(file);
          } catch {
            const url = URL.createObjectURL(file);
            const img = new Image();
            img.src = url;
            await img.decode();
            const bmp = await createImageBitmap(img);
            URL.revokeObjectURL(url);
            return bmp;
          }
        }
      }

      let loading = false;
      async function addFiles(files) {
        if (loading) return;
        loading = true;
        statusEl.textContent = "正在读取图片…";
        let firstAdded = null;
        for (const file of Array.from(files)) {
          if (!file.type.startsWith("image/")) continue;
          try {
            const bitmap = await decode(file);
            const item = {
              id: `i${++state.seq}`,
              name: file.name,
              mime: file.type || "image/png",
              bitmap,
              w0: bitmap.width,
              h0: bitmap.height,
              crop: null,
              edit: { ...EDIT_DEFAULTS },
            };
            state.items.push(item);
            if (!firstAdded) firstAdded = item;
          } catch (err) {
            console.warn("[image-tool] 无法读取", file.name, err);
          }
        }
        loading = false;

        if (!state.items.length) {
          statusEl.textContent = "没有读取到可用的图片";
          return;
        }

        renderStrip();
        syncLayout();
        // 新加的图片直接切成当前编辑对象
        setActive(firstAdded ? firstAdded.id : state.items[0].id);
        scheduleRedraw();
        if (!firstAdded) statusEl.textContent = "没有读取到可用的图片";
      }

      drop.addEventListener("click", () => input.click());
      drop.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          input.click();
        }
      });

      input.addEventListener("change", () => {
        if (input.files?.length) addFiles(input.files);
        input.value = "";
      });

      // 页面级拖入
      let dragDepth = 0;
      let overlay = null;
      window.addEventListener("dragenter", (e) => {
        if (!e.dataTransfer?.types.includes("Files")) return;
        dragDepth++;
        drop.classList.add("is-over");
        if (!overlay) {
          overlay = document.createElement("div");
          overlay.className = "img-drop-overlay";
          overlay.innerHTML = "<span>松手即可添加图片</span>";
          document.body.appendChild(overlay);
        }
      });
      window.addEventListener("dragleave", (e) => {
        if (!e.dataTransfer?.types.includes("Files")) return;
        dragDepth = Math.max(0, dragDepth - 1);
        if (dragDepth === 0) {
          drop.classList.remove("is-over");
          overlay?.remove();
          overlay = null;
        }
      });
      window.addEventListener("dragover", (e) => {
        if (e.dataTransfer?.types.includes("Files")) e.preventDefault();
      });
      window.addEventListener("drop", (e) => {
        if (!e.dataTransfer?.types.includes("Files")) return;
        e.preventDefault();
        dragDepth = 0;
        drop.classList.remove("is-over");
        overlay?.remove();
        overlay = null;
        if (e.dataTransfer.files?.length) addFiles(e.dataTransfer.files);
      });

      // ── 面板交互 ──────────────────────────────────────

      document.getElementById("seg-format").addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-format]");
        if (!btn) return;
        applyEdit({ format: btn.dataset.format });
        syncPanel();
      });

      document.getElementById("in-quality").addEventListener("input", (e) => {
        const v = Number(e.target.value);
        document.getElementById("val-quality").textContent = `${v}%`;
        applyEdit({ quality: v });
      });

      document.getElementById("in-width").addEventListener("input", (e) => {
        const v = Number(e.target.value);
        applyEdit({ width: v > 0 ? Math.round(v) : null });
        syncWidthLabel();
      });

      document.getElementById("seg-crop").addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-ratio]");
        if (!btn) return;
        applyEdit({ cropRatio: btn.dataset.ratio });
        syncPanel();
      });

      document.getElementById("btn-rot-l").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        applyEdit({ rotate: (item.edit.rotate + 270) % 360 });
      });

      document.getElementById("btn-rot-r").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        applyEdit({ rotate: (item.edit.rotate + 90) % 360 });
      });

      for (const [id, key] of [
        ["btn-flip-h", "flipH"],
        ["btn-flip-v", "flipV"],
      ]) {
        document.getElementById(id).addEventListener("click", () => {
          const item = activeItem();
          if (!item) return;
          applyEdit({ [key]: !item.edit[key] });
          syncPanel();
        });
      }

      for (const [id, key, outId] of [
        ["in-bright", "brightness", "val-bright"],
        ["in-contrast", "contrast", "val-contrast"],
        ["in-saturate", "saturate", "val-saturate"],
        ["in-radius", "radius", "val-radius"],
      ]) {
        document.getElementById(id).addEventListener("input", (e) => {
          const v = Number(e.target.value);
          document.getElementById(outId).textContent = `${v}%`;
          applyEdit({ [key]: v });
        });
      }

      document.getElementById("btn-reset").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        item.crop = null;
        item.edit = { ...EDIT_DEFAULTS };
        syncPanel();
        scheduleRedraw();
        statusEl.textContent = "已重置这张";
      });

      document.getElementById("btn-apply-all").addEventListener("click", () => {
        const src = activeItem();
        if (!src) return;
        const base = { ...src.edit };
        let n = 0;
        for (const it of state.items) {
          if (it === src) continue;
          it.edit = { ...base };
          n++;
        }
        scheduleRedraw();
        statusEl.textContent = n
          ? `已把当前设置应用到其余 ${n} 张（手动裁剪不复制）`
          : "只有一张图片，无需应用";
      });

      // ── 手动裁剪 ──────────────────────────────────────

      const MIN_BOX = 20;
      let closeCropper = null;

      function openCropper(item) {
        if (closeCropper) closeCropper();
        if (!item) return;

        const layer = document.createElement("div");
        layer.className = "crop-layer";
        layer.innerHTML = `
          <div class="crop-head">
            <strong>裁剪</strong>
            <span class="crop-name"></span>
            <span class="crop-tip">拖角缩放 · 框内移动 · 空白处重新框选</span>
          </div>
          <div class="crop-stage">
            <div class="crop-frame">
              <canvas class="crop-canvas"></canvas>
              <div class="crop-box">
                <i class="crop-handle" data-h="nw"></i>
                <i class="crop-handle" data-h="ne"></i>
                <i class="crop-handle" data-h="sw"></i>
                <i class="crop-handle" data-h="se"></i>
                <em class="crop-size"></em>
              </div>
            </div>
          </div>
          <div class="crop-bar">
            <button type="button" class="crop-btn" data-act="reset">重置</button>
            <button type="button" class="crop-btn" data-act="ratio">按当前比例</button>
            <span class="crop-spacer"></span>
            <button type="button" class="crop-btn" data-act="cancel">取消</button>
            <button type="button" class="crop-btn crop-btn-primary" data-act="apply">应用</button>
          </div>
        `;
        document.body.appendChild(layer);
        layer.querySelector(".crop-name").textContent = item.name;

        // 锁住底层滚动，避免关闭后页面位置跑掉
        const prevOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        const close = () => {
          document.body.style.overflow = prevOverflow;
          layer.remove();
          if (closeCropper === close) closeCropper = null;
        };
        closeCropper = close;

        const stage = layer.querySelector(".crop-stage");
        const frame = layer.querySelector(".crop-frame");
        const canvas = layer.querySelector(".crop-canvas");
        const boxEl = layer.querySelector(".crop-box");
        const sizeEl = layer.querySelector(".crop-size");

        // 按可用空间等比铺开
        const cs = getComputedStyle(stage);
        const availW =
          stage.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        const availH =
          stage.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        const imgRatio = item.w0 / item.h0;
        let dispW = Math.max(80, availW);
        let dispH = dispW / imgRatio;
        if (dispH > availH) {
          dispH = Math.max(80, availH);
          dispW = dispH * imgRatio;
        }
        dispW = Math.round(dispW);
        dispH = Math.round(dispH);

        frame.style.width = dispW + "px";
        frame.style.height = dispH + "px";
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.round(dispW * dpr);
        canvas.height = Math.round(dispH * dpr);
        canvas.style.width = dispW + "px";
        canvas.style.height = dispH + "px";
        const cctx = canvas.getContext("2d");
        cctx.imageSmoothingQuality = "high";
        cctx.drawImage(item.bitmap, 0, 0, canvas.width, canvas.height);

        function ratioBox() {
          const r = RATIOS[item.edit.cropRatio];
          if (!r) return { x: 0, y: 0, w: dispW, h: dispH };
          let w = dispW;
          let h = w / r;
          if (h > dispH) {
            h = dispH;
            w = h * r;
          }
          return { x: (dispW - w) / 2, y: (dispH - h) / 2, w, h };
        }

        function initialBox() {
          if (item.crop) {
            return {
              x: item.crop.x * dispW,
              y: item.crop.y * dispH,
              w: Math.max(MIN_BOX, item.crop.w * dispW),
              h: Math.max(MIN_BOX, item.crop.h * dispH),
            };
          }
          return ratioBox();
        }

        let box = initialBox();

        function paint() {
          boxEl.style.left = box.x + "px";
          boxEl.style.top = box.y + "px";
          boxEl.style.width = box.w + "px";
          boxEl.style.height = box.h + "px";
          const cw = Math.max(1, Math.round((box.w / dispW) * item.w0));
          const ch = Math.max(1, Math.round((box.h / dispH) * item.h0));
          sizeEl.textContent = `${cw} × ${ch}`;
        }
        paint();

        let drag = null;

        function local(e) {
          const r = frame.getBoundingClientRect();
          return { x: e.clientX - r.left, y: e.clientY - r.top };
        }

        frame.addEventListener("pointerdown", (e) => {
          if (e.button !== 0 && e.button !== undefined) return;
          e.preventDefault();
          const p = local(e);
          const handle = e.target.closest(".crop-handle");
          if (handle) {
            const c = handle.dataset.h;
            drag = {
              mode: "handle",
              corner: c,
              anchor: {
                nw: { x: box.x + box.w, y: box.y + box.h },
                ne: { x: box.x, y: box.y + box.h },
                sw: { x: box.x + box.w, y: box.y },
                se: { x: box.x, y: box.y },
              }[c],
            };
          } else if (e.target.closest(".crop-box")) {
            drag = { mode: "move", start: p, box0: { ...box } };
          } else {
            drag = { mode: "new", start: p, dirX: 1, dirY: 1, first: true };
          }
          frame.setPointerCapture?.(e.pointerId);
        });

        frame.addEventListener("pointermove", (e) => {
          if (!drag) return;
          const p = local(e);

          if (drag.mode === "move") {
            const maxX = dispW - drag.box0.w;
            const maxY = dispH - drag.box0.h;
            box = {
              w: drag.box0.w,
              h: drag.box0.h,
              x: Math.min(maxX, Math.max(0, drag.box0.x + (p.x - drag.start.x))),
              y: Math.min(maxY, Math.max(0, drag.box0.y + (p.y - drag.start.y))),
            };
            paint();
            return;
          }

          if (drag.mode === "handle") {
            const a = drag.anchor;
            const c = drag.corner;
            let w = Math.abs(p.x - a.x);
            let h = Math.abs(p.y - a.y);
            const r = RATIOS[item.edit.cropRatio];
            if (r) {
              // 取更“大”的方向定尺寸，保证指针落在框内
              if (h * r > w) w = h * r;
              h = w / r;
            }
            w = Math.max(MIN_BOX, w);
            h = Math.max(MIN_BOX, h);
            const maxW = c.includes("w") ? a.x : dispW - a.x;
            const maxH = c.includes("n") ? a.y : dispH - a.y;
            const k = Math.min(1, maxW / w, maxH / h);
            w *= k;
            h *= k;
            box = {
              w,
              h,
              x: c.includes("w") ? a.x - w : a.x,
              y: c.includes("n") ? a.y - h : a.y,
            };
            paint();
            return;
          }

          // 新建选框
          if (drag.first) {
            drag.first = false;
            drag.dirX = p.x >= drag.start.x ? 1 : -1;
            drag.dirY = p.y >= drag.start.y ? 1 : -1;
          }
          let w = Math.abs(p.x - drag.start.x);
          let h = Math.abs(p.y - drag.start.y);
          const r = RATIOS[item.edit.cropRatio];
          if (r) {
            if (h * r > w) w = h * r;
            h = w / r;
          }
          w = Math.max(MIN_BOX, Math.min(w, dispW));
          h = Math.max(MIN_BOX, Math.min(h, dispH));
          let x = drag.dirX > 0 ? drag.start.x : drag.start.x - w;
          let y = drag.dirY > 0 ? drag.start.y : drag.start.y - h;
          x = Math.min(Math.max(0, x), dispW - w);
          y = Math.min(Math.max(0, y), dispH - h);
          box = { x, y, w, h };
          paint();
        });

        const endDrag = () => {
          drag = null;
        };
        frame.addEventListener("pointerup", endDrag);
        frame.addEventListener("pointercancel", endDrag);

        layer.addEventListener("click", (e) => {
          const btn = e.target.closest(".crop-btn");
          if (!btn) return;
          const act = btn.dataset.act;

          if (act === "cancel") {
            close();
            return;
          }

          if (act === "reset") {
            item.crop = null;
            box = ratioBox();
            paint();
            return;
          }

          if (act === "ratio") {
            box = ratioBox();
            paint();
            return;
          }

          if (act === "apply") {
            const isFull =
              box.x <= 0.5 &&
              box.y <= 0.5 &&
              box.w >= dispW - 1 &&
              box.h >= dispH - 1;
            item.crop = isFull
              ? null
              : {
                  x: box.x / dispW,
                  y: box.y / dispH,
                  w: box.w / dispW,
                  h: box.h / dispH,
                };
            const label = sizeEl.textContent;
            close();
            scheduleRedraw();
            statusEl.textContent = isFull ? "已取消裁剪" : `已裁剪为 ${label}`;
          }
        });
      }

      document.getElementById("btn-crop-one").addEventListener("click", () => {
        openCropper(activeItem());
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && closeCropper) closeCropper();
      });

      // ── 导出 ──────────────────────────────────────────

      function toBlob(canvas, mime, quality) {
        return new Promise((resolve, reject) => {
          canvas.toBlob(
            (b) => (b ? resolve(b) : reject(new Error("toBlob 返回空"))),
            mime,
            mime === "image/png" ? undefined : quality / 100,
          );
        });
      }

      async function renderBlob(item) {
        const canvas = document.createElement("canvas");
        drawItem(canvas, item, null);
        const mime = mimeOf(item);

        if (mime === "image/jpeg") {
          // JPEG 没有透明通道，先铺白底，否则透明区域会变黑
          const flat = document.createElement("canvas");
          flat.width = canvas.width;
          flat.height = canvas.height;
          const fctx = flat.getContext("2d");
          fctx.fillStyle = "#ffffff";
          fctx.fillRect(0, 0, flat.width, flat.height);
          fctx.drawImage(canvas, 0, 0);
          return { blob: await toBlob(flat, mime, item.edit.quality), mime };
        }
        return { blob: await toBlob(canvas, mime, item.edit.quality), mime };
      }

      function baseName(name) {
        return name.replace(/\.[^./\\]+$/, "") || "image";
      }

      function saveBlob(blob, filename) {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 6000);
      }

      async function exportList(list) {
        if (!list.length) return;
        const total = list.length;
        for (let i = 0; i < total; i++) {
          statusEl.textContent = `正在导出 ${i + 1}/${total}…`;
          try {
            const { blob, mime } = await renderBlob(list[i]);
            const ext = EXT[mime] || "png";
            saveBlob(blob, `${baseName(list[i].name)}.${ext}`);
          } catch (err) {
            console.warn("[image-tool] 导出失败", list[i].name, err);
          }
          // 多张连续下载之间留间隔，避免浏览器拦截
          if (i < total - 1) await new Promise((r) => setTimeout(r, 320));
        }
        statusEl.textContent = `已导出 ${total} 张`;
      }

      document.getElementById("btn-save-one").addEventListener("click", () => {
        const item = activeItem();
        if (!item) return;
        exportList([item]);
      });

      btnExportEdited.addEventListener("click", () => {
        exportList(state.items.filter(isEdited));
      });

      btnExportAll.addEventListener("click", () => {
        exportList([...state.items]);
      });

      // ── 初始化 ────────────────────────────────────────

      syncLayout();
      syncPanel();
      syncActions();
    </script>
  </body>
</html>
