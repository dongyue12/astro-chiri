---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostGrid from '@/components/PostGrid.astro';
import { getTagName, themeConfig } from '@/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const ids = [...new Set(posts.flatMap((post) => post.data.tags))];

  return ids.map((id) => ({
    params: { tag: id },
    props: { id },
  }));
}

const { id } = Astro.props;
const name = getTagName(id);
const posts = (await getCollection('blog'))
  .filter((post) => post.data.tags.includes(id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${name} · 标签 · ${themeConfig.site.title}`}>
  <header class="page-hero">
    <h1>
      <span class="hash">#</span>{name}
    </h1>
    <p class="page-meta">
      <span>{posts.length} 篇</span>
      <a href="/tags/">全部标签 →</a>
    </p>
  </header>

  <PostGrid posts={posts} />
</BaseLayout>

<style>
  .page-meta a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .page-meta a:hover {
    color: var(--accent);
  }
</style>
