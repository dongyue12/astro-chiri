---
import { getCollection } from 'astro:content';
import IndexLayout from '@/layouts/IndexLayout.astro';
import PostList from '@/components/PostList.astro';
import { themeConfig } from '@/config';

// 搜索用文本：保留代码块和表格里的内容（命令名这类关键词恰恰在那里），
// 只剥掉 markdown 语法符号。整段内联进 data-search，搜索时无需任何网络请求。
function searchable(md = '') {
  return md
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`|~]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    pubDate: post.data.pubDate,
    search: searchable(post.body),
  }));
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <input
    slot="toolbar"
    id="search"
    type="search"
    placeholder="搜索文章…"
    autocomplete="off"
    spellcheck="false"
    aria-controls="post-list"
    aria-label="搜索文章"
  />
  <PostList posts={posts} listId="post-list" />
  <p id="empty" class="empty" hidden>没有匹配的文章</p>
</IndexLayout>

<script is:inline>
  (function () {
    var input = document.getElementById('search');
    var list = document.getElementById('post-list');
    if (!input || !list) return;

    // 列表由服务端渲染，搜索只切换 hidden —— 布局与行样式完全不变，
    // 且禁用 JS 时整份列表依然可见。
    var rows = Array.prototype.slice.call(list.children);
    var empty = document.getElementById('empty');
    var composing = false;

    function apply() {
      var q = input.value.trim().toLowerCase();
      var terms = q ? q.split(/\s+/) : [];
      var shown = 0;

      rows.forEach(function (row) {
        var haystack = row.getAttribute('data-search') || '';
        var match = terms.every(function (t) {
          return haystack.indexOf(t) !== -1;
        });
        row.hidden = !match;
        if (match) shown++;
      });

      if (empty) empty.hidden = shown !== 0;
    }

    // 中文输入法：组字过程中不过滤，选词完成后再应用
    input.addEventListener('compositionstart', function () {
      composing = true;
    });
    input.addEventListener('compositionend', function () {
      composing = false;
      apply();
    });
    input.addEventListener('input', function () {
      if (!composing) apply();
    });
  })();
</script>

<style>
  input {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    letter-spacing: var(--spacing-m);
    color: var(--text-primary);
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    padding: 0 0 0.5rem;
    margin: 0 0 1.25rem;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    /* 占位文字、输入内容与光标都居中；下划线仍为整栏宽度 */
    text-align: center;
  }
  input::placeholder {
    color: var(--text-tertiary);
  }
  input:focus {
    border-bottom-color: var(--text-tertiary);
  }
  input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .empty {
    margin: 0;
    color: var(--text-secondary);
    opacity: 0.75;
    font-weight: var(--font-weight-light);
  }
</style>
