---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostGrid from '@/components/PostGrid.astro';
import {
  categories,
  excerptFrom,
  formatPostDate,
  getCategory,
  getTagName,
  readingMinutes,
  themeConfig,
} from '@/config';

// 搜索用文本：保留代码块和表格里的内容（命令名这类关键词恰恰在那里），只剥掉 markdown 语法。
// 字符类刻意不含连字符：`by-sa`、`up`-`down` 这类词要能整体搜到。
function searchable(md = '') {
  return md
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`|~]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    category: getCategory(post.data.category),
    // 搜索也认分类名和标签名：搜「VSCode」能命中所有打了这个标签的文章
    search: [
      post.data.title,
      post.data.description ?? '',
      getCategory(post.data.category).name,
      post.data.tags.map(getTagName).join(' '),
      searchable(post.body),
    ].join(' '),
  }));

const latest = posts[0];
const latestExcerpt = latest.data.description ?? excerptFrom(latest.body, 90);
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;

const chips = categories.map((category) => ({
  ...category,
  count: posts.filter((post) => post.data.category === category.id).length,
}));

// 搜索索引整段内联为 JSON，搜索时零网络请求。顺序与卡片 DOM 一致，按下标取用。
// 正文里可能出现 `</script>`，转义 `\<` 免得提前截断这段 JSON。
const searchIndex = JSON.stringify(posts.map((post) => post.search)).replace(/</g, '\\u003c');
---

<BaseLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <section class="hero">
    <div class="hero-copy">
      <h1>{themeConfig.site.title}</h1>
      <p class="hero-lead">{themeConfig.site.description}</p>
      <div class="hero-stats">
        <div>
          <b>{posts.length}</b>
          <span>篇笔记</span>
        </div>
        <div>
          <b>{chips.length}</b>
          <span>个分类</span>
        </div>
        <div>
          <b>{tagCount}</b>
          <span>个标签</span>
        </div>
      </div>
    </div>

    <a class={`featured cat-${latest.category.id}`} href={`/${latest.id}/`}>
      <span class="featured-top">
        <span class="featured-label">最新</span>
        <span class="cat">{latest.category.name}</span>
      </span>
      <h2>{latest.data.title}</h2>
      <p>{latestExcerpt}</p>
      <span class="featured-foot">
        <time datetime={latest.data.pubDate.toISOString().slice(0, 10)}>
          {formatPostDate(latest.data.pubDate)}
        </time>
        <span>{readingMinutes(latest.body)} 分钟阅读</span>
        <span class="arrow" aria-hidden="true">→</span>
      </span>
    </a>
  </section>

  <section class="index" aria-labelledby="all-posts">
    <div class="index-bar">
      <div class="chips" role="group" aria-label="按分类筛选">
        <button class="chip" type="button" data-cat="all" aria-pressed="true">
          全部<span>{posts.length}</span>
        </button>
        {
          chips.map((category) => (
            <button
              class={`chip cat-${category.id}`}
              type="button"
              data-cat={category.id}
              aria-pressed="false"
            >
              {category.name}
              <span>{category.count}</span>
            </button>
          ))
        }
      </div>

      <div class="search">
        <svg class="search-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7.2" cy="7.2" r="4.7" stroke="currentColor" stroke-width="1.4"></circle>
          <path
            d="m10.8 10.8 3 3"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"></path>
        </svg>
        <input
          id="search"
          type="search"
          placeholder="搜索文章、命令或关键词"
          autocomplete="off"
          spellcheck="false"
          aria-controls="post-list"
          aria-label="搜索文章"
        />
        <kbd class="search-hint" aria-hidden="true">/</kbd>
      </div>
    </div>

    <div class="index-head">
      <h2 id="all-posts">全部文章</h2>
      <span class="result-count" id="result-count" aria-live="polite">{posts.length} 篇</span>
    </div>

    <div id="post-list">
      <PostGrid posts={posts} />
    </div>
    <p id="empty" role="status" hidden>没有匹配的文章，换个关键词或分类试试。</p>
  </section>
</BaseLayout>

<script type="application/json" id="search-index" set:html={searchIndex} />

<script is:inline>
  (function () {
    var input = document.getElementById('search');
    var list = document.getElementById('post-list');
    var index = document.getElementById('search-index');
    if (!input || !list || !index) return;

    // 卡片由服务端渲染，搜索只切换 hidden —— 布局与样式完全不变，
    // 且禁用 JS 时整份列表依然可见。
    var data = JSON.parse(index.textContent);
    var items = list.querySelectorAll('.post-item');
    var chips = document.querySelectorAll('.chip');
    var empty = document.getElementById('empty');
    var counter = document.getElementById('result-count');
    var composing = false;
    var activeCat = 'all';

    function apply() {
      var terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      var shown = 0;

      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        var match = activeCat === 'all' || item.dataset.cat === activeCat;

        if (match && terms.length) {
          var haystack = data[i].toLowerCase();
          for (var j = 0; j < terms.length; j++) {
            if (haystack.indexOf(terms[j]) === -1) {
              match = false;
              break;
            }
          }
        }

        item.hidden = !match;
        if (match) shown++;
      }

      if (counter) counter.textContent = shown + ' 篇';
      if (empty) empty.hidden = shown !== 0;
    }

    // 中文输入法：组字过程中不过滤，选词完成后再应用
    input.addEventListener('compositionstart', function () {
      composing = true;
    });
    input.addEventListener('compositionend', function () {
      composing = false;
      apply();
    });
    input.addEventListener('input', function () {
      if (!composing) apply();
    });

    // 分类筛选和搜索叠加生效
    for (var c = 0; c < chips.length; c++) {
      chips[c].addEventListener('click', function () {
        activeCat = this.dataset.cat;
        for (var k = 0; k < chips.length; k++) {
          chips[k].setAttribute('aria-pressed', String(chips[k] === this));
        }
        apply();
      });
    }

    // 键盘用户：/ 或 Ctrl/Cmd + K 直接聚焦搜索，Esc 清空并退出
    document.addEventListener('keydown', function (e) {
      var typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
      if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        input.focus();
        input.select();
      } else if (e.key === 'Escape' && document.activeElement === input) {
        input.value = '';
        apply();
        input.blur();
      }
    });
  })();
</script>

<style>
  /* 首屏：左边站点主张，右边最新一篇。留白和字号把主次拉开 */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 4rem;
    align-items: end;
    padding-block: 1rem 5rem;
  }

  .hero h1 {
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .hero-lead {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .hero-stats {
    display: flex;
    gap: 2.75rem;
    margin-top: 2.75rem;
  }

  .hero-stats b {
    display: block;
    font-family: var(--mono);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .hero-stats span {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  /* 最新一篇：一张有分类色的卡，是首屏里唯一的彩色块 */
  .featured {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.6rem 1.6rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: linear-gradient(
      155deg,
      color-mix(in srgb, var(--cat) 9%, var(--surface)),
      var(--surface) 62%
    );
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-s);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .featured:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--cat) 45%, var(--line));
    box-shadow: var(--shadow-m);
  }

  .featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .featured-label {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .featured h2 {
    margin: 0.4rem 0 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .featured p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .featured-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .featured-foot .arrow {
    margin-left: auto;
    font-size: 0.9375rem;
    transition: transform var(--dur) var(--ease);
  }

  .featured:hover .arrow {
    transform: translateX(4px);
    color: var(--cat);
  }

  /* 索引区：筛选和搜索放一行，卡片网格在下面 */
  .index {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .index-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    font: inherit;
    font-size: var(--text-s);
    line-height: 1.5;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .chip span {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur) var(--ease);
  }

  .chip:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .chip[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .chip[aria-pressed='true'] span {
    color: var(--accent);
  }

  .search {
    position: relative;
    flex: 0 1 19rem;
    margin-left: auto;
  }

  .search-icon {
    position: absolute;
    left: 0.95rem;
    top: 50%;
    translate: 0 -50%;
    width: 1rem;
    height: 1rem;
    color: var(--ink-3);
    pointer-events: none;
  }

  input {
    width: 100%;
    height: 2.6rem;
    padding: 0 3rem 0 2.65rem;
    font: inherit;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  input::placeholder {
    color: var(--ink-3);
  }

  input:hover {
    border-color: var(--line);
  }

  input:focus {
    background: var(--surface);
    border-color: var(--accent-line);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-hint {
    position: absolute;
    right: 0.7rem;
    top: 50%;
    translate: 0 -50%;
    min-width: 1.4rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--ink-3);
    text-align: center;
    pointer-events: none;
  }

  .index-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 3rem 0 1.25rem;
  }

  .index-head h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .result-count {
    font-family: var(--mono);
    font-size: var(--text-s);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  #empty {
    margin: 2rem 0 0;
    padding: 3rem 0;
    text-align: center;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  @media (hover: none) {
    .search-hint {
      display: none;
    }
    input {
      padding-right: 1rem;
    }
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-bottom: 3.5rem;
    }
    .featured {
      max-width: 40rem;
    }
  }

  @media (max-width: 600px) {
    /* 手机上首屏只留「标题 + 统计 + 筛选」，最新一篇在下面的卡片里照样是第一条 */
    .hero {
      gap: 0;
      padding-bottom: 2.5rem;
    }
    .featured {
      display: none;
    }
    .hero-stats {
      gap: 1.75rem;
      margin-top: 2rem;
    }
    .search {
      order: -1;
      flex: 1 1 100%;
      margin-left: 0;
    }
    .index-bar {
      gap: 0.9rem;
    }
    /* 分类条改为横向滑动，不再折成两行 */
    .chips {
      flex-wrap: nowrap;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }
    .chips::-webkit-scrollbar {
      display: none;
    }
    .chip {
      flex: none;
    }
    .index-head {
      margin-top: 2.25rem;
    }
  }
</style>
