---
import { themeConfig } from '@/config';
---

<header>
  <nav>
    <a class="site-title" href="/">{themeConfig.site.title}</a>
    <div class="site-links">
      <a href="/message/">留言</a>
      <a href="/friends/">友链</a>
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .site-title {
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
    min-width: 3rem;
    display: inline-block;
  }
  .site-links {
    display: flex;
    gap: 1rem;
  }
  .site-links a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .site-links a:hover {
    color: var(--text-primary);
  }
</style>
