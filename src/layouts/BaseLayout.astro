---
/**
 * 全站外壳：<head>、吸顶页头、内容区、页脚、明暗主题开关。
 *
 * 刻意只留这一个通用布局：从前 BaseHead / Header / Footer 三个组件加上
 * BaseLayout / IndexLayout 两层布局，每个页面要 import 四五个文件才拼出一个外壳，
 * 而它们都只被本站三四个页面用到，收益不抵开销。现在页面只 import 这一个。
 *
 * 页头页脚都是 76rem 宽的通栏，正文页自己决定内部网格（文章页是「侧边目录 + 正文」）。
 */
import '@/styles/global.css';
import { siteNav, themeConfig } from '@/config';

interface Props {
  title: string;
  description?: string;
  /** og:type。文章页传 article，其余用 website */
  ogType?: 'website' | 'article';
  /** 分享卡片图，绝对路径或相对 Astro.site 的路径；传 null 表示不输出 */
  ogImage?: string | null;
  /** 文章发布时间（ISO 字符串），仅 ogType=article 时有意义 */
  publishedTime?: string;
  /** 文章修改时间（ISO 字符串） */
  updatedTime?: string;
  /** 结构化数据（JSON-LD），传对象即可，自动序列化并转义 */
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description = themeConfig.site.description,
  ogType = 'website',
  ogImage = themeConfig.site.ogImage,
  publishedTime,
  updatedTime,
  jsonLd = null,
} = Astro.props;
const { language, author } = themeConfig.site;
const year = new Date().getFullYear();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : null;
const contentWidth = parseFloat(themeConfig.contentWidth) || 43;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <!-- 先定主题再渲染，避免深色模式刷新时闪一下白 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={themeConfig.site.title} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={themeConfig.site.title} />
    <meta property="og:locale" content={language.replace('-', '_')} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {ogImageURL && <meta property="og:image:width" content="1200" />}
    {ogImageURL && <meta property="og:image:height" content="630" />}
    {ogImageURL && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {ogType === 'article' && <meta property="article:author" content={author} />}
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>

  <body style={`--content-width: ${contentWidth}rem;`}>
    <a class="skip-link" href="#main">跳到正文</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          {themeConfig.site.title}
        </a>
        <nav class="site-nav" aria-label="站点导航">
          {
            siteNav.map((item) => (
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深色模式">
          <svg class="icon-sun" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.4"></circle>
            <path
              d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6 5.9 5.9 0 1 0 13.4 9.6Z"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <div class="shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/">{themeConfig.site.title}</a>
          <p>{themeConfig.site.description}</p>
        </div>
        <nav class="footer-nav" aria-label="页脚导航">
          {
            siteNav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a href="/rss.xml">RSS</a>
        </nav>
        <div class="footer-meta">
          <p>&copy; {year} {author}</p>
          <p>Powered by <a href="https://astro.build">Astro</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    var root = document.documentElement;
    if (!btn) return;

    function label() {
      btn.setAttribute('aria-label', root.dataset.theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
    }

    // 评论区是第三方 iframe，不会自己跟着本站的手动主题走，切换后单独通知它
    function syncGiscus() {
      var theme = root.dataset.theme === 'dark' ? 'dark' : 'light';
      document.querySelectorAll('iframe.giscus-frame').forEach(function (frame) {
        frame.contentWindow.postMessage({ giscus: { setConfig: { theme: theme } } }, 'https://giscus.app');
      });
    }

    btn.addEventListener('click', function () {
      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      label();
      syncGiscus();
    });

    // 没手动选过时跟随系统变化；选过就尊重用户的选择
    try {
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      mq.addEventListener('change', function (e) {
        if (localStorage.getItem('theme')) return;
        root.dataset.theme = e.matches ? 'dark' : 'light';
        label();
        syncGiscus();
      });
    } catch (e) {}

    // giscus 是懒加载的，等它的 iframe 出现后再同步一次主题
    new MutationObserver(function () {
      if (document.querySelector('iframe.giscus-frame')) syncGiscus();
    }).observe(document.body, { childList: true, subtree: true });

    label();
  })();
</script>

<style>
  /* 键盘用户第一下 Tab 就能跳过页头；鼠标用户看不见它 */
  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 1rem;
    z-index: 100;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-s);
    text-decoration: none;
    transform: translateY(-250%);
    transition: transform var(--dur) var(--ease);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* 跳到正文后焦点落在整个内容区，不要给它画一个框 */
  main:focus {
    outline: none;
  }
</style>
