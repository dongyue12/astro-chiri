---
/**
 * 文章页布局：标题、日期、正文、giscus 评论、返回顶部按钮。
 *
 * 评论的 giscus 配置从前单独有一个 Comments 组件，但它只被文章页和留言页用到，
 * 两处合并不划算；这里直接内联，留言页仍复用这个布局（`commentTitle=""`）。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { themeConfig } from '@/config';

interface Props {
  /** 浏览器标题（`<title>`），通常是「文章名 · 站点名」 */
  title: string;
  /** 正文大标题（`<h1>`），省略时用 title。留言页靠它把标题和 SEO 标题分开 */
  heading?: string;
  description?: string;
  /** 缺省则不显示日期行（留言页用） */
  pubDate?: Date;
  updatedDate?: Date;
  /** 评论小标题；传空字符串表示只要评论区、不要标题 */
  commentTitle?: string;
}

const {
  title,
  heading = title,
  description,
  pubDate,
  updatedDate,
  commentTitle = '评论',
} = Astro.props;
const siteTitle = themeConfig.site.title;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const pad = (n: number) => String(n).padStart(2, '0');

/** 按 themeConfig.date 渲染日期。未知格式回退为 年.月.日 */
function formatDate(date: Date) {
  const { format, separator } = themeConfig.date;
  const sep = ['.', '-', '/'].includes(separator) ? separator : '.';
  const y = date.getFullYear();
  const m = date.getMonth() + 1;
  const d = date.getDate();
  const month = MONTHS[date.getMonth()];

  switch (format) {
    case 'MM-DD-YYYY':
      return `${pad(m)}${sep}${pad(d)}${sep}${y}`;
    case 'DD-MM-YYYY':
      return `${pad(d)}${sep}${pad(m)}${sep}${y}`;
    case 'MONTH DAY YYYY':
      return `${month} ${d} ${y}`;
    case 'DAY MONTH YYYY':
      return `${d} ${month} ${y}`;
    default:
      return `${y}${sep}${pad(m)}${sep}${pad(d)}`;
  }
}
---

<BaseLayout title={`${title} · ${siteTitle}`} description={description}>
  <article>
    <div class="title">
      <h1>{heading}</h1>
      {
        pubDate && (
          <p class="date">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {updatedDate && (
              <span class="updated">
                <span>·</span>更新于{' '}
                <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            )}
          </p>
        )
      }
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>

  <section class="comments" aria-label={commentTitle || '评论'}>
    {commentTitle && <h2>{commentTitle}</h2>}
    <script
      src="https://giscus.app/client.js"
      data-repo="dongyue12/giscus"
      data-repo-id="R_kgDOSakHjA"
      data-category="Announcements"
      data-category-id="DIC_kwDOSakHjM4C8zJM"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-loading="lazy"
      data-lang={themeConfig.site.language}
      crossorigin="anonymous"
      async
      is:inline></script>
  </section>

  <div class="to-top-wrap">
    <button id="to-top" class="to-top" type="button" aria-label="返回顶部">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path
          d="M6 10.5V2M6 2 2.1 5.9M6 2l3.9 3.9"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var btn = document.getElementById('to-top');
    if (!btn) return;
    var shown = false;

    function update() {
      var y = window.scrollY || document.documentElement.scrollTop;
      // 靠近页面底部时收起，避免压住页脚
      var nearBottom = y + window.innerHeight > document.documentElement.scrollHeight - 160;
      var shouldShow = y > 400 && !nearBottom;
      if (shouldShow !== shown) {
        shown = shouldShow;
        btn.classList.toggle('show', shouldShow);
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0 });
    });
    update();
  })();
</script>

<style>
  article {
    flex: 1;
  }
  .title {
    margin-top: 1.5rem;
  }
  .date {
    margin-top: 0.375rem;
  }
  .updated {
    color: var(--text-secondary);
    letter-spacing: var(--spacing-s);
  }
  .updated span {
    margin: 0 0.25em;
  }

  .comments {
    margin-bottom: 4rem;
  }
  .comments h2 {
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    margin: 0 0 1.5rem;
  }

  /* 与内容栏同宽居中，按钮右对齐到正文右边缘，而不是飘在视口角落 */
  .to-top-wrap {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: 1.5rem;
    width: 100%;
    max-width: var(--content-width);
    padding: 0 1.5rem;
    box-sizing: border-box;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 10;
  }
  .to-top {
    pointer-events: auto;
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0.5px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text-secondary);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease-out,
      color 0.2s ease-out,
      visibility 0.2s;
  }
  .to-top.show {
    opacity: 1;
    visibility: visible;
  }
  .to-top:hover {
    color: var(--text-primary);
  }
  @media (hover: none) and (pointer: coarse) {
    .to-top:hover {
      color: var(--text-secondary);
    }
  }
  @media (max-width: 768px) {
    .to-top-wrap {
      padding: 0 1.35rem;
    }
  }
</style>
