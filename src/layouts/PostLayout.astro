---
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Header from '@/components/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { themeConfig } from '@/config';

interface Props {
  title: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, pubDate, updatedDate } = Astro.props;
---

<BaseLayout title={`${title} · ${themeConfig.site.title}`}>
  <BaseHead title={`${title} · ${themeConfig.site.title}`} slot="head" />
  <div class="post-container">
    <Header />
    <main>
      <div class="prose">
        <div class="title">
          <h1>{title}</h1>
          <div class="date">
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <span class="updated">
                  <span class="separator">·</span>更新于 <FormattedDate date={updatedDate} />
                </span>
              )
            }
          </div>
        </div>
        <article class="content">
          <slot />
        </article>
      </div>
    </main>
    {themeConfig.general.footer && <Footer />}
    <div class="to-top-wrap">
      <button id="to-top" class="to-top" type="button" aria-label="返回顶部">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M6 10.5V2M6 2 2.1 5.9M6 2l3.9 3.9"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var btn = document.getElementById('to-top');
    if (!btn) return;
    var shown = false;

    function update() {
      var y = window.scrollY || document.documentElement.scrollTop;
      // 靠近页面底部时收起，避免压住页脚
      var nearBottom =
        y + window.innerHeight > document.documentElement.scrollHeight - 160;
      var shouldShow = y > 400 && !nearBottom;
      if (shouldShow !== shown) {
        shown = shouldShow;
        btn.classList.toggle('show', shouldShow);
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0 });
    });
    update();
  })();
</script>

<style>
  .post-container {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .post-container main {
    flex: 1;
  }
  .prose .title {
    margin-top: 1.5rem;
  }
  .prose .updated {
    color: var(--text-secondary);
    letter-spacing: var(--spacing-s);
  }
  .prose .updated .separator {
    margin: 0 0.25em;
  }

  /* 与内容栏同宽居中，按钮右对齐到正文右边缘，而不是飘在视口角落 */
  .to-top-wrap {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: 1.5rem;
    width: 100%;
    max-width: var(--content-width);
    padding: 0 1.5rem;
    box-sizing: border-box;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 10;
  }
  .to-top {
    pointer-events: auto;
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0.5px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text-secondary);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease-out,
      color 0.2s ease-out,
      visibility 0.2s;
  }
  .to-top.show {
    opacity: 1;
    visibility: visible;
  }
  .to-top:hover {
    color: var(--text-primary);
  }
  @media (hover: none) and (pointer: coarse) {
    .to-top:hover {
      color: var(--text-secondary);
    }
  }
  @media (max-width: 768px) {
    .to-top-wrap {
      padding: 0 1.35rem;
    }
  }
</style>
