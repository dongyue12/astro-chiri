---
/**
 * 文章页布局：标题区、正文、可选侧边目录、评论、返回顶部、阅读进度。
 *
 * 布局是「侧栏目录 + 正文」两栏：目录来自页面通过 aside 插槽传入的 <details>，
 * 宽屏时展开并吸顶，窄屏时收成标题上方的一行。没有目录的短文章自动退回单栏。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatPostDate, themeConfig } from '@/config';

interface Props {
  /** 浏览器标题（`<title>`），通常是「文章名 · 站点名」 */
  title: string;
  /** 正文大标题（`<h1>`），省略时用 title。留言页靠它把标题和 SEO 标题分开 */
  heading?: string;
  description?: string;
  /** 缺省则不显示日期行（留言页用） */
  pubDate?: Date;
  updatedDate?: Date;
  /** 预计阅读时间（分钟），由文章页按正文长度算好传来 */
  readingTime?: number;
  /** 分类，传 id 和显示名；文章页用，留言页不传 */
  category?: { id: string; name: string };
  /** 评论小标题；传空字符串表示只要评论区、不要标题 */
  commentTitle?: string;
}

const {
  title,
  heading = title,
  description,
  pubDate,
  updatedDate,
  readingTime,
  category,
  commentTitle = '评论',
} = Astro.props;
const siteTitle = themeConfig.site.title;
const hasAside = Astro.slots.has('aside');

// 结构化数据：让搜索结果能拿富摘要。仅有日期且传了 pubDate 的文章页才输出
const articleLd = pubDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: heading,
      description,
      inLanguage: themeConfig.site.language,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      author: { '@type': 'Person', name: themeConfig.site.author },
      image: new URL(themeConfig.site.ogImage, Astro.site).href,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': new URL(Astro.url.pathname, Astro.site).href,
      },
    }
  : null;
---

<BaseLayout
  title={`${title} · ${siteTitle}`}
  description={description}
  ogType={pubDate ? 'article' : 'website'}
  publishedTime={pubDate?.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  jsonLd={articleLd}
>
  {/* 阅读进度：纯 CSS 滚动时间线，不支持的浏览器不显示，也不影响阅读 */}
  {pubDate && <div class="read-progress" aria-hidden="true"></div>}

  <article class:list={['post-body', hasAside && 'with-aside']}>
    {
      hasAside && (
        <aside class="post-aside" aria-label="文章目录">
          <slot name="aside" />
        </aside>
      )
    }

    <header class="post-hero">
      {
        pubDate && (
          <div class="post-meta">
            {category && (
              <a class={`cat cat-${category.id}`} href={`/categories/${category.id}/`}>
                {category.name}
              </a>
            )}
            <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
            {readingTime && <span>{readingTime} 分钟阅读</span>}
            {updatedDate && (
              <span>
                更新于 <time datetime={updatedDate.toISOString()}>{formatPostDate(updatedDate)}</time>
              </span>
            )}
          </div>
        )
      }
      <h1>{heading}</h1>
      {description && <p class="post-summary">{description}</p>}
    </header>

    <div class="prose">
      <slot />
    </div>

    <section class="comments" aria-label={commentTitle || '评论'}>
      {commentTitle && <h2 class="comments-title">{commentTitle}</h2>}
      <script
        src="https://giscus.app/client.js"
        data-repo="dongyue12/giscus"
        data-repo-id="R_kgDOSakHjA"
        data-category="Announcements"
        data-category-id="DIC_kwDOSakHjM4C8zJM"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-loading="lazy"
        data-lang={themeConfig.site.language}
        crossorigin="anonymous"
        async
        is:inline></script>
    </section>
  </article>

  <div class="to-top-wrap">
    <button id="to-top" class="to-top" type="button" aria-label="返回顶部">
      <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path
          d="M6 10.5V2M6 2 2.1 5.9M6 2l3.9 3.9"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var btn = document.getElementById('to-top');
    if (!btn) return;
    var shown = false;

    function update() {
      var y = window.scrollY || document.documentElement.scrollTop;
      // 靠近页面底部时收起，避免压住页脚
      var nearBottom = y + window.innerHeight > document.documentElement.scrollHeight - 160;
      var shouldShow = y > 500 && !nearBottom;
      if (shouldShow !== shown) {
        shown = shouldShow;
        btn.classList.toggle('show', shouldShow);
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0 });
    });
    update();
  })();
</script>

<script is:inline>
  // 宽屏把目录默认展开，窄屏收成一行；读者手动收起后不再自动改回去
  (function () {
    var toc = document.querySelector('.toc');
    if (!toc) return;
    var wide = window.matchMedia('(min-width: 1081px)');
    if (wide.matches) toc.open = true;
    wide.addEventListener('change', function (e) {
      if (e.matches) toc.open = true;
    });
  })();
</script>

<script is:inline>
  // 给每个代码块加复制按钮。纯 DOM 注入，禁用 JS 时只是没有按钮，代码照常显示。
  (function () {
    var blocks = document.querySelectorAll('.prose pre');
    if (!blocks.length || !navigator.clipboard) return;

    blocks.forEach(function (pre) {
      var code = pre.querySelector('code');
      if (!code) return;

      var wrap = document.createElement('div');
      wrap.className = 'code-block';
      if (pre.dataset.language) wrap.dataset.lang = pre.dataset.language;
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      var btn = document.createElement('button');
      btn.className = 'copy-code';
      btn.type = 'button';
      btn.textContent = '复制';
      btn.setAttribute('aria-label', '复制这段代码');
      wrap.appendChild(btn);

      var timer;
      function reset(label) {
        clearTimeout(timer);
        btn.textContent = label;
        timer = setTimeout(function () {
          btn.textContent = '复制';
        }, 1500);
      }

      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(code.textContent).then(
          function () {
            reset('已复制');
          },
          function () {
            reset('复制失败');
          },
        );
      });
    });
  })();
</script>

<script is:inline>
  // 表格包一层横向滚动容器，窄屏里不把列挤成竖条。
  (function () {
    document.querySelectorAll('.prose table').forEach(function (table) {
      var wrap = document.createElement('div');
      wrap.className = 'table-wrap';
      wrap.tabIndex = 0;
      wrap.setAttribute('role', 'region');
      wrap.setAttribute('aria-label', '表格，可左右滚动');
      table.parentNode.insertBefore(wrap, table);
      wrap.appendChild(table);
    });
  })();
</script>

<script is:inline>
  // 点正文图片看大图。原生 dialog：Esc 或点任意处关闭，打开时背景不可滚动。
  (function () {
    var imgs = document.querySelectorAll('.prose img');
    if (!imgs.length || typeof HTMLDialogElement === 'undefined') return;

    imgs.forEach(function (img) {
      img.classList.add('zoomable');
      img.addEventListener('click', function () {
        var dialog = document.createElement('dialog');
        dialog.className = 'img-viewer';

        var big = document.createElement('img');
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        dialog.appendChild(big);

        document.body.appendChild(dialog);
        dialog.showModal();

        dialog.addEventListener('click', function () {
          dialog.close();
        });
        dialog.addEventListener('close', function () {
          dialog.remove();
        });
      });
    });
  })();
</script>

<style>
  /* 两栏骨架：目录 14rem + 正文 43rem，整体居中。
     没有目录的文章（留言页、短文章）自动只留正文一栏。 */
  .post-body {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width, 43rem));
    justify-content: center;
  }

  .post-body.with-aside {
    grid-template-columns: 14rem minmax(0, var(--content-width, 43rem));
    column-gap: 4rem;
  }

  .post-aside {
    grid-column: 1;
    grid-row: 1 / span 3;
    align-self: start;
    position: sticky;
    top: 6.5rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .post-hero,
  .prose,
  .comments {
    grid-column: 1;
    min-width: 0;
  }

  .with-aside .post-hero,
  .with-aside .prose,
  .with-aside .comments {
    grid-column: 2;
  }

  .post-hero {
    margin-bottom: 2.75rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    margin-bottom: 1.25rem;
    font-family: var(--mono);
    font-size: var(--text-s);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .post-meta .cat {
    font-family: var(--sans);
    font-size: var(--text-s);
  }

  .post-hero h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .post-summary {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .comments {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .comments-title {
    margin: 0 0 1.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  /* 返回顶部：视口右下角，白底毛玻璃，和正文栏解耦 */
  .to-top-wrap {
    position: fixed;
    right: 1.75rem;
    bottom: 1.75rem;
    z-index: 40;
    pointer-events: none;
  }

  .to-top {
    pointer-events: auto;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--ink-2);
    box-shadow: var(--shadow-s);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      visibility var(--dur);
  }

  .to-top.show {
    opacity: 1;
    visibility: visible;
  }

  .to-top:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  /* 阅读进度：2px 朱砂线。滚动时间线需要 animation-duration: auto，
     写成 0s 的话动画不会跟着滚动走。 */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .read-progress {
        animation: read-progress linear both;
        animation-duration: auto;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 1080px) {
    .post-body,
    .post-body.with-aside {
      grid-template-columns: minmax(0, var(--content-width, 43rem));
      justify-content: center;
    }
    .post-aside {
      grid-column: 1;
      grid-row: 1;
      position: static;
      max-height: none;
      overflow: visible;
      margin-bottom: 2rem;
    }
    .with-aside .post-hero,
    .with-aside .prose,
    .with-aside .comments {
      grid-column: 1;
    }
    .post-body.with-aside {
      grid-template-rows: auto auto auto auto;
    }
    .with-aside .post-hero {
      grid-row: 2;
    }
    .with-aside .prose {
      grid-row: 3;
    }
    .with-aside .comments {
      grid-row: 4;
    }
  }

  @media (max-width: 768px) {
    .post-hero {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }
    .comments {
      margin-top: 3.5rem;
    }
    .to-top-wrap {
      right: 1rem;
      bottom: 1rem;
    }
  }
</style>
