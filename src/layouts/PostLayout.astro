---
/**
 * 文章页布局：标题、日期、正文、giscus 评论、返回顶部按钮。
 *
 * 评论的 giscus 配置从前单独有一个 Comments 组件，但它只被文章页和留言页用到，
 * 两处合并不划算；这里直接内联，留言页仍复用这个布局（`commentTitle=""`）。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatPostDate, themeConfig } from '@/config';

interface Props {
  /** 浏览器标题（`<title>`），通常是「文章名 · 站点名」 */
  title: string;
  /** 正文大标题（`<h1>`），省略时用 title。留言页靠它把标题和 SEO 标题分开 */
  heading?: string;
  description?: string;
  /** 缺省则不显示日期行（留言页用） */
  pubDate?: Date;
  updatedDate?: Date;
  /** 评论小标题；传空字符串表示只要评论区、不要标题 */
  commentTitle?: string;
}

const {
  title,
  heading = title,
  description,
  pubDate,
  updatedDate,
  commentTitle = '评论',
} = Astro.props;
const siteTitle = themeConfig.site.title;
---

<BaseLayout title={`${title} · ${siteTitle}`} description={description}>
  <article>
    <div class="title">
      <h1>{heading}</h1>
      {
        pubDate && (
          <p class="date">
            <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
            {updatedDate && (
              <span class="updated">
                <span>·</span>更新于{' '}
                <time datetime={updatedDate.toISOString()}>{formatPostDate(updatedDate)}</time>
              </span>
            )}
          </p>
        )
      }
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>

  <section class="comments" aria-label={commentTitle || '评论'}>
    {commentTitle && <h2>{commentTitle}</h2>}
    <script
      src="https://giscus.app/client.js"
      data-repo="dongyue12/giscus"
      data-repo-id="R_kgDOSakHjA"
      data-category="Announcements"
      data-category-id="DIC_kwDOSakHjM4C8zJM"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-loading="lazy"
      data-lang={themeConfig.site.language}
      crossorigin="anonymous"
      async
      is:inline></script>
  </section>

  <div class="to-top-wrap">
    <button id="to-top" class="to-top" type="button" aria-label="返回顶部">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path
          d="M6 10.5V2M6 2 2.1 5.9M6 2l3.9 3.9"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var btn = document.getElementById('to-top');
    if (!btn) return;
    var shown = false;

    function update() {
      var y = window.scrollY || document.documentElement.scrollTop;
      // 靠近页面底部时收起，避免压住页脚
      var nearBottom = y + window.innerHeight > document.documentElement.scrollHeight - 160;
      var shouldShow = y > 400 && !nearBottom;
      if (shouldShow !== shown) {
        shown = shouldShow;
        btn.classList.toggle('show', shouldShow);
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0 });
    });
    update();
  })();
</script>

<script is:inline>
  // 给每个代码块加复制按钮。纯 DOM 注入，禁用 JS 时只是没有按钮，代码照常显示。
  (function () {
    var blocks = document.querySelectorAll('.prose pre');
    if (!blocks.length || !navigator.clipboard) return;

    blocks.forEach(function (pre) {
      var code = pre.querySelector('code');
      if (!code) return;

      var wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      var btn = document.createElement('button');
      btn.className = 'copy-code';
      btn.type = 'button';
      btn.textContent = '复制';
      btn.setAttribute('aria-label', '复制这段代码');
      wrap.appendChild(btn);

      var timer;
      function reset(label) {
        clearTimeout(timer);
        btn.textContent = label;
        timer = setTimeout(function () {
          btn.textContent = '复制';
        }, 1500);
      }

      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(code.textContent).then(
          function () {
            reset('已复制');
          },
          function () {
            reset('复制失败');
          },
        );
      });
    });
  })();
</script>

<script is:inline>
  // 点正文图片看大图。原生 dialog：Esc 或点任意处关闭，打开时背景不可滚动。
  (function () {
    var imgs = document.querySelectorAll('.prose img');
    if (!imgs.length || typeof HTMLDialogElement === 'undefined') return;

    imgs.forEach(function (img) {
      img.classList.add('zoomable');
      img.addEventListener('click', function () {
        var dialog = document.createElement('dialog');
        dialog.className = 'img-viewer';

        var big = document.createElement('img');
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        dialog.appendChild(big);

        document.body.appendChild(dialog);
        dialog.showModal();

        dialog.addEventListener('click', function () {
          dialog.close();
        });
        dialog.addEventListener('close', function () {
          dialog.remove();
        });
      });
    });
  })();
</script>

<style>
  article {
    flex: 1;
  }
  .title {
    margin-top: 1rem;
  }
  .date {
    margin-top: 0.5rem;
  }
  .updated {
    color: var(--text-secondary);
    letter-spacing: var(--spacing-s);
  }
  .updated span {
    margin: 0 0.25em;
  }

  .comments {
    margin-bottom: 4rem;
  }
  .comments h2 {
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    margin: 0 0 1.5rem;
  }

  /* 与内容栏同宽居中，按钮右对齐到正文右边缘，而不是飘在视口角落 */
  .to-top-wrap {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: 1.5rem;
    width: 100%;
    max-width: var(--content-width);
    padding: 0 1.5rem;
    box-sizing: border-box;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 10;
  }
  .to-top {
    pointer-events: auto;
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0.5px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text-secondary);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease-out,
      color 0.2s ease-out,
      visibility 0.2s;
  }
  .to-top.show {
    opacity: 1;
    visibility: visible;
  }
  .to-top:hover {
    color: var(--text-primary);
  }
  @media (hover: none) and (pointer: coarse) {
    .to-top:hover {
      color: var(--text-secondary);
    }
  }
  @media (max-width: 768px) {
    .to-top-wrap {
      padding: 0 1.35rem;
    }
  }
</style>
