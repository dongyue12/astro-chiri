    { "source": "/23/", "destination": "/posts/23/", "permanent": true },
    { "source": "/24/", "destination": "/posts/24/", "permanent": true },
    { "source": "/25/", "destination": "/posts/25/", "permanent": true },
    { "source": "/26/", "destination": "/posts/26/", "permanent": true },
    { "source": "/message/", "destination": "/guestbook/", "permanent": true },
    { "source": "/categories/dev/", "destination": "/categories/", "permanent": true },
    { "source": "/categories/system/", "destination": "/categories/", "permanent": true },
    { "source": "/categories/misc/", "destination": "/categories/", "permanent": true }
  ]
}
